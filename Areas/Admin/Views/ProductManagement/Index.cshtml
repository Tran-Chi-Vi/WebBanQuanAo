@model List<Product>
@{
    ViewData["Title"] = "Quản Lý Sản Phẩm & Tồn Kho";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var brands = ViewBag.Brands as List<Brand> ?? new List<Brand>();
}

<style>
    /* Table & Modal Theme High-Contrast Enforcement */
    .table-product-admin {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }
    .table-product-admin th {
        font-weight: 700;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 14px 16px;
        white-space: nowrap;
    }
    .table-product-admin td {
        padding: 14px 16px;
        vertical-align: middle;
    }
    .col-prod-img { width: 70px; min-width: 70px; }
    .col-prod-name { min-width: 260px; }
    .col-prod-cat { min-width: 130px; }
    .col-prod-brand { min-width: 130px; }
    .col-prod-price { min-width: 130px; }
    .col-prod-stock { min-width: 140px; }
    .col-prod-status { min-width: 110px; }
    .col-prod-actions { min-width: 240px; text-align: right; }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold font-heading m-0 text-body"><i class="bi bi-box-seam-fill text-primary me-2"></i> QUẢN LÝ SẢN PHẨM & TỒN KHO</h4>
        <small class="text-muted">Tổng số: <strong class="text-body">@ViewBag.TotalItems</strong> sản phẩm trong hệ thống</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="ProductManagement" asp-action="Create" class="btn btn-primary shadow-sm fw-bold px-3 py-2 rounded-3" title="Tạo sản phẩm thời trang mới vào kho hàng" aria-label="Thêm sản phẩm mới vào hệ thống">
            <i class="bi bi-plus-lg me-1"></i> Thêm Sản Phẩm Mới
        </a>
    </div>
</div>

<!-- Filters Bar -->
<div class="card p-3.5 border-0 shadow-sm rounded-4 bg-body mb-4">
    <form asp-area="Admin" asp-controller="ProductManagement" asp-action="Index" method="get" class="row g-3">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="searchQuery" class="form-control border-start-0 ps-0" placeholder="Tìm theo tên sản phẩm..." value="@ViewBag.SearchQuery" aria-label="Tìm kiếm sản phẩm theo tên" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select rounded-3">
                <option value="">-- Tất cả danh mục --</option>
                @foreach (var c in categories)
                {
                    <option value="@c.CategoryId" selected="@(ViewBag.CategoryId == c.CategoryId)">@c.CategoryName</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="brandId" class="form-select rounded-3">
                <option value="">-- Tất cả thương hiệu --</option>
                @foreach (var b in brands)
                {
                    <option value="@b.BrandId" selected="@(ViewBag.BrandId == b.BrandId)">@b.BrandName</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100 fw-bold py-2"><i class="bi bi-funnel me-1"></i> Lọc</button>
        </div>
    </form>
</div>

<!-- Product Master Table -->
<div class="card p-3 p-md-4 border-0 shadow-sm rounded-4 bg-body">
    <div class="table-responsive">
        <table class="table align-middle table-product-admin">
            <thead>
                <tr class="table-light">
                    <th class="col-prod-img">Hình Ảnh</th>
                    <th class="col-prod-name">Tên Sản Phẩm</th>
                    <th class="col-prod-cat">Danh Mục</th>
                    <th class="col-prod-brand">Thương Hiệu</th>
                    <th class="col-prod-price">Giá Gốc</th>
                    <th class="col-prod-stock">Tồn Kho</th>
                    <th class="col-prod-status">Trạng Thái</th>
                    <th class="col-prod-actions">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="text-body">
                @foreach (var p in Model)
                {
                    var img = p.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? p.Images.FirstOrDefault()?.ImageUrl ?? "/images/no-image.png";
                    int totalStock = p.Variants.Sum(v => v.StockQuantity);

                    <tr>
                        <td class="col-prod-img">
                            <img src="@img" alt="@p.ProductName" class="rounded-3 shadow-sm border" style="width: 54px; height: 54px; object-fit: cover;" />
                        </td>
                        <td class="col-prod-name">
                            <div class="fw-bold text-body fs-6 mb-0.5">@p.ProductName</div>
                            <small class="text-muted font-monospace">@p.Variants.Count size/màu biến thể</small>
                        </td>
                        <td class="col-prod-cat small text-muted fw-semibold">@p.Category?.CategoryName</td>
                        <td class="col-prod-brand small text-muted fw-semibold">@p.Brand?.BrandName</td>
                        <td class="col-prod-price fw-bold text-primary">@p.BasePrice.ToString("N0")đ</td>
                        <td class="col-prod-stock">
                            @if (totalStock > 0)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold px-2.5 py-1.5 rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i> Còn @totalStock SP
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold px-2.5 py-1.5 rounded-pill">
                                    <i class="bi bi-exclamation-octagon-fill me-1"></i> HẾT HÀNG (0 SP)
                                </span>
                            }
                        </td>
                        <td class="col-prod-status">
                            <span class="badge @(p.Status == ProductStatus.Active ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border border-secondary-subtle") fw-bold px-2.5 py-1 rounded-pill">@p.Status</span>
                        </td>
                        <td class="col-prod-actions">
                            <div class="d-flex gap-2 align-items-center justify-content-end">
                                <button type="button" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1 fw-bold px-3 py-1.5"
                                        data-bs-toggle="modal" data-bs-target="#restockModal-@p.ProductId"
                                        title="Cập nhật tồn kho sản phẩm @p.ProductName" aria-label="Nhập hàng @p.ProductName"
                                        style="border-radius:8px;font-size:0.82rem;white-space:nowrap;">
                                    <i class="bi bi-plus-circle-fill"></i> Nhập Hàng
                                </button>
                                <a asp-area="Admin" asp-controller="ProductManagement" asp-action="Edit" asp-route-id="@p.ProductId"
                                   class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 fw-semibold px-2.5 py-1.5"
                                   title="Chỉnh sửa sản phẩm @p.ProductName" aria-label="Sửa @p.ProductName"
                                   style="border-radius:8px;font-size:0.82rem;white-space:nowrap;">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                <form asp-area="Admin" asp-controller="ProductManagement" asp-action="Delete" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.ProductId" />
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 fw-semibold px-2.5 py-1.5"
                                            title="Xóa sản phẩm @p.ProductName" aria-label="Xóa @p.ProductName"
                                            style="border-radius:8px;font-size:0.82rem;white-space:nowrap;">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Render All Modals Outside Table for 100% Valid HTML DOM Parsing -->
@foreach (var p in Model)
{
    <div class="modal fade" id="restockModal-@p.ProductId" tabindex="-1" aria-labelledby="restockLabel-@p.ProductId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow-lg bg-body">
                <form asp-area="Admin" asp-controller="ProductManagement" asp-action="QuickRestock" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@p.ProductId" />
                    
                    <div class="modal-header bg-body-tertiary rounded-top-4 border-bottom px-4 py-3">
                        <h5 class="modal-title fw-bold text-body" id="restockLabel-@p.ProductId">
                            <i class="bi bi-box-seam text-success me-2 fs-5"></i> Nhập Hàng Tồn Kho: <span class="text-primary">@p.ProductName</span>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    
                    <div class="modal-body p-4 bg-body text-body">
                        <p class="text-muted small mb-3">Cập nhật số lượng tồn kho cho các biến thể Size/Màu sắc để sản phẩm sẵn sàng mở bán lại trên trang web:</p>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr class="table-light">
                                        <th>Mã SKU</th>
                                        <th>Size</th>
                                        <th>Màu Sắc</th>
                                        <th>Giá</th>
                                        <th style="width: 220px;">Tồn Kho Hiện Tại</th>
                                    </tr>
                                </thead>
                                <tbody class="text-body">
                                    @foreach (var v in p.Variants)
                                    {
                                        <tr>
                                            <td class="font-monospace small fw-bold text-muted">@v.SKU</td>
                                            <td><span class="badge bg-primary-subtle text-primary fw-bold px-2 py-1">@v.Size</span></td>
                                            <td><span class="badge bg-secondary-subtle text-secondary-emphasis border px-2 py-1">@v.Color</span></td>
                                            <td class="fw-bold">@v.Price.ToString("N0")đ</td>
                                            <td>
                                                <div class="input-group input-group-sm">
                                                    <input type="number" name="variantStocks[@v.VariantId]" 
                                                           id="input-stock-@v.VariantId" 
                                                           class="form-control text-center font-monospace fw-bold" 
                                                           value="@v.StockQuantity" min="0" />
                                                    <button type="button" class="btn btn-outline-success font-monospace" onclick="addStockValue(@v.VariantId, 20)" title="Cộng thêm 20 SP">+20</button>
                                                    <button type="button" class="btn btn-outline-success font-monospace" onclick="addStockValue(@v.VariantId, 50)" title="Cộng thêm 50 SP">+50</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    
                    <div class="modal-footer bg-body-tertiary rounded-bottom-4 border-top px-4 py-3">
                        <button type="button" class="btn btn-secondary rounded-3 px-3" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-success fw-bold px-4 rounded-3 shadow-sm">
                            <i class="bi bi-check-circle-fill me-1"></i> Lưu Cập Nhật Tồn Kho
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<script>
    function addStockValue(variantId, count) {
        const input = document.getElementById(`input-stock-${variantId}`);
        if (input) {
            let current = parseInt(input.value) || 0;
            input.value = current + count;
        }
    }
</script>

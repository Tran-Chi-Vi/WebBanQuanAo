@model AdminProductFormViewModel
@{
    ViewData["Title"] = "Thêm Sản Phẩm Mới";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold font-heading m-0">THÊM SẢN PHẨM MỚI</h4>
    <a asp-area="Admin" asp-controller="ProductManagement" asp-action="Index" class="btn btn-sm btn-outline-custom"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="card p-4 border-0 shadow-sm rounded-4 bg-white max-w-800 mx-auto" style="max-width: 800px;">
    <form asp-area="Admin" asp-controller="ProductManagement" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label asp-for="ProductName" class="form-label fw-bold small">Tên Sản Phẩm (*)</label>
            <input asp-for="ProductName" class="form-control rounded-3" placeholder="Ví dụ: Áo Sơ Mi Nam Cotton Cao Cấp" required />
            <span asp-validation-for="ProductName" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label fw-bold small">Danh Mục (*)</label>
                <select asp-for="CategoryId" class="form-select rounded-3" required>
                    <option value="">-- Chọn danh mục --</option>
                    @foreach (var c in Model.AvailableCategories)
                    {
                        <option value="@c.CategoryId">@c.CategoryName</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="BrandId" class="form-label fw-bold small">Thương Hiệu (*)</label>
                <select asp-for="BrandId" class="form-select rounded-3" required>
                    <option value="">-- Chọn thương hiệu --</option>
                    @foreach (var b in Model.AvailableBrands)
                    {
                        <option value="@b.BrandId">@b.BrandName</option>
                    }
                </select>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label asp-for="BasePrice" class="form-label fw-bold small">Giá Gốc (VNĐ) (*)</label>
                <input asp-for="BasePrice" type="number" class="form-control rounded-3" placeholder="250000" required />
            </div>
            <div class="col-md-4">
                <label asp-for="Gender" class="form-label fw-bold small">Giới Tính</label>
                <select asp-for="Gender" class="form-select rounded-3">
                    <option value="0">Nam</option>
                    <option value="1">Nữ</option>
                    <option value="2">Unisex</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Status" class="form-label fw-bold small">Trạng Thái</label>
                <select asp-for="Status" class="form-select rounded-3">
                    <option value="1">Đang kinh doanh (Active)</option>
                    <option value="0">Ngưng kinh doanh (Discontinued)</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="MainImageUrl" class="form-label fw-bold small">Đường Dẫn Ảnh Chính (URL Image)</label>
            <input asp-for="MainImageUrl" class="form-control rounded-3" placeholder="https://example.com/image.jpg" />
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label fw-bold small">Mô Tả Sản Phẩm</label>
            <textarea asp-for="Description" class="form-control rounded-3" rows="4" placeholder="Nhập mô tả chi tiết..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary-gradient btn-lg w-100 py-3 font-heading fw-bold shadow-lg" title="Bấm để lưu sản phẩm thời trang mới vào hệ thống" aria-label="Tạo sản phẩm thời trang mới">
            TẠO SẢN PHẨM MỚI
        </button>
    </form>
</div>

@model List<Category>
@{
    ViewData["Title"] = "Quản Lý Danh Mục Sản Phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold font-heading m-0">QUẢN LÝ DANH MỤC SẢN PHẨM</h4>
    <button type="button" class="btn btn-primary-gradient" data-bs-toggle="modal" data-bs-target="#createCatModal">
        + Thêm Danh Mục Mới
    </button>
</div>

<div class="card p-4 border-0 shadow-sm rounded-4 bg-white">
    <div class="table-responsive">
        <table class="table table-custom align-middle">
            <thead>
                <tr>
                    <th>Mã ID</th>
                    <th>Tên Danh Mục</th>
                    <th>Danh Mục Cha</th>
                    <th>Số Sản Phẩm</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-bold font-monospace">#@c.CategoryId</td>
                        <td class="fw-bold text-dark">@c.CategoryName</td>
                        <td>
                            @if (c.ParentCategory != null)
                            {
                                <span class="badge bg-light text-dark border">@c.ParentCategory.CategoryName</span>
                            }
                            else
                            {
                                <span class="text-muted small">Cấp cha</span>
                            }
                        </td>
                        <td><span class="badge bg-primary">@c.Products.Count SP</span></td>
                        <td>
                            <form asp-area="Admin" asp-controller="CategoryBrand" asp-action="DeleteCategory" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục này?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.CategoryId" />
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 fw-semibold"
                                        style="border-radius:8px;font-size:0.82rem;white-space:nowrap;">
                                    <i class="bi bi-trash"></i> Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Category Modal -->
<div class="modal fade" id="createCatModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Thêm Danh Mục Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-area="Admin" asp-controller="CategoryBrand" asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên Danh Mục (*)</label>
                        <input type="text" name="categoryName" class="form-control rounded-3" placeholder="Ví dụ: Áo Sơ Mi" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Danh Mục Cha (Nếu có)</label>
                        <select name="parentCategoryId" class="form-select rounded-3">
                            <option value="">-- Không có (Danh mục gốc) --</option>
                            @foreach (var p in Model.Where(x => x.ParentCategoryId == null))
                            {
                                <option value="@p.CategoryId">@p.CategoryName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary-gradient">Tạo Danh Mục</button>
                </div>
            </form>
        </div>
    </div>
</div>

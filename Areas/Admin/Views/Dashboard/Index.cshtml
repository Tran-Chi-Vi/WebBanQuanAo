@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Tổng Quan Quản Trị (Dashboard)";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<!-- Stat Metric Cards Row -->
<div class="row g-3 g-md-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card p-4 rounded-4 bg-body border shadow-sm position-relative overflow-hidden" style="transition:transform 0.3s ease, box-shadow 0.3s ease;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small fw-bold text-uppercase" style="letter-spacing:0.05em;">TỔNG DOANH THU</span>
                <div class="stat-icon-box rounded-3 d-flex align-items-center justify-content-center text-success" style="width:42px;height:42px;background:#d1fae5;font-size:1.25rem;">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
            <h3 class="fw-bold font-heading text-body m-0 font-monospace" style="font-size:1.65rem;">@Model.TotalRevenue.ToString("N0")đ</h3>
            <small class="text-success fw-semibold"><i class="bi bi-graph-up-arrow me-1"></i>Đơn đã hoàn thành/giao</small>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card p-4 rounded-4 bg-body border shadow-sm position-relative overflow-hidden" style="transition:transform 0.3s ease, box-shadow 0.3s ease;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small fw-bold text-uppercase" style="letter-spacing:0.05em;">TỔNG ĐƠN HÀNG</span>
                <div class="stat-icon-box rounded-3 d-flex align-items-center justify-content-center text-primary" style="width:42px;height:42px;background:#e0e7ff;font-size:1.25rem;">
                    <i class="bi bi-cart-check-fill"></i>
                </div>
            </div>
            <h3 class="fw-bold font-heading text-body m-0 font-monospace" style="font-size:1.65rem;">@Model.TotalOrders</h3>
            <small class="text-warning fw-bold"><i class="bi bi-clock-history me-1"></i>@Model.PendingOrdersCount đơn chờ xử lý</small>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card p-4 rounded-4 bg-body border shadow-sm position-relative overflow-hidden" style="transition:transform 0.3s ease, box-shadow 0.3s ease;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small fw-bold text-uppercase" style="letter-spacing:0.05em;">TỔNG SẢN PHẨM</span>
                <div class="stat-icon-box rounded-3 d-flex align-items-center justify-content-center text-warning" style="width:42px;height:42px;background:#fef3c7;font-size:1.25rem;">
                    <i class="bi bi-box-seam-fill"></i>
                </div>
            </div>
            <h3 class="fw-bold font-heading text-body m-0 font-monospace" style="font-size:1.65rem;">@Model.TotalProducts</h3>
            <small class="text-muted">Sản phẩm đang kinh doanh</small>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card p-4 rounded-4 bg-white border border-light shadow-sm position-relative overflow-hidden" style="transition:transform 0.3s ease, box-shadow 0.3s ease;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small fw-bold text-uppercase" style="letter-spacing:0.05em;">KHÁCH HÀNG</span>
                <div class="stat-icon-box rounded-3 d-flex align-items-center justify-content-center text-danger" style="width:42px;height:42px;background:#fee2e2;font-size:1.25rem;">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <h3 class="fw-bold font-heading text-dark m-0 font-monospace" style="font-size:1.65rem;">@Model.TotalCustomers</h3>
            <small class="text-muted">Tài khoản đã đăng ký</small>
        </div>
    </div>
</div>

<!-- Overview Charts Row -->
<div class="row g-4 mb-4">
    <!-- Revenue Bar Chart -->
    <div class="col-lg-8">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold font-heading m-0 text-dark" style="font-size:1.1rem;"><i class="bi bi-bar-chart-line-fill text-primary me-2"></i> BIỂU ĐỒ DOANH THU CỬA HÀNG</h5>
                <span class="badge bg-light text-dark border">6 Tháng Gần Nhất</span>
            </div>
            <div style="height: 300px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Order Status Doughnut Chart -->
    <div class="col-lg-4">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <h5 class="fw-bold font-heading mb-3 text-dark" style="font-size:1.1rem;"><i class="bi bi-pie-chart-fill text-success me-2"></i> TỶ LỆ ĐƠN HÀNG HỆ THỐNG</h5>
            <div style="height: 260px;">
                <canvas id="orderStatusChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Category Growth Line Chart -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold font-heading m-0 text-dark" style="font-size:1.1rem;"><i class="bi bi-graph-up text-warning me-2"></i> PHÂN TÍCH TĂNG TRƯỞNG & ĐƠN HÀNG MỚI</h5>
                <span class="badge bg-primary">Real-time Analytics</span>
            </div>
            <div style="height: 280px;">
                <canvas id="growthChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // 1. Revenue Bar Chart
            const ctxRev = document.getElementById('revenueChart').getContext('2d');
            const monthlyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueByMonth));
            const labels = monthlyData.map(d => `Tháng ${d.Month}/${d.Year}`);
            const revenues = monthlyData.map(d => d.Revenue);

            new Chart(ctxRev, {
                type: 'bar',
                data: {
                    labels: labels.length > 0 ? labels : ['Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6', 'Tháng 7'],
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: revenues.length > 0 ? revenues : [12000000, 19000000, 25000000, 32000000, 45000000],
                        backgroundColor: 'rgba(99, 102, 241, 0.85)',
                        borderColor: '#6366f1',
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } }
                }
            });

            // 2. Order Status Doughnut Chart
            const ctxStatus = document.getElementById('orderStatusChart').getContext('2d');
            new Chart(ctxStatus, {
                type: 'doughnut',
                data: {
                    labels: ['Tổng Đơn Hàng', 'Chờ Xử Lý (Pending)'],
                    datasets: [{
                        data: [Math.max(1, @Model.TotalOrders - @Model.PendingOrdersCount), @Model.PendingOrdersCount],
                        backgroundColor: ['#10b981', '#f59e0b']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            // 3. Growth Line Chart
            const ctxGrowth = document.getElementById('growthChart').getContext('2d');
            new Chart(ctxGrowth, {
                type: 'line',
                data: {
                    labels: ['Tuần 1', 'Tuần 2', 'Tuần 3', 'Tuần 4', 'Tuần 5', 'Tuần 6'],
                    datasets: [{
                        label: 'Số Đơn Hàng Mới Tăng Trưởng',
                        data: [5, 12, 18, 25, 32, 45],
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.15)',
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } }
                }
            });
        });
    </script>
}

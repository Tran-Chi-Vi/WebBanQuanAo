@model AdminPromotionFormViewModel
@{
    ViewData["Title"] = "Chỉnh Sửa Mã Khuyến Mãi #" + Model.Code;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold font-heading m-0">CHỈNH SỬA MÃ KHUYẾN MÃI: @Model.Code</h4>
    <a asp-area="Admin" asp-controller="Promotion" asp-action="Index" class="btn btn-sm btn-outline-custom" title="Quay lại danh sách khuyến mãi" aria-label="Quay lại danh sách khuyến mãi"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="card p-4 border-0 shadow-sm rounded-4 bg-white max-w-600 mx-auto" style="max-width: 600px;">
    <form asp-area="Admin" asp-controller="Promotion" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PromotionId" />
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label asp-for="Code" class="form-label fw-bold small">Mã Giảm Giá (*)</label>
            <input asp-for="Code" class="form-control rounded-3 text-uppercase font-monospace fw-bold" title="Nhập mã giảm giá" aria-label="Mã giảm giá" required />
            <span asp-validation-for="Code" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="DiscountType" class="form-label fw-bold small">Loại Giảm Giá</label>
                <select asp-for="DiscountType" class="form-select rounded-3" title="Chọn loại giảm giá" aria-label="Loại giảm giá">
                    <option value="0">Phần trăm (%)</option>
                    <option value="1">Số tiền cố định (VNĐ)</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="DiscountValue" class="form-label fw-bold small">Giá Trị Giảm (*)</label>
                <input asp-for="DiscountValue" type="number" class="form-control rounded-3" title="Nhập giá trị giảm" aria-label="Giá trị giảm" required />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="MinOrderValue" class="form-label fw-bold small">Giá Trị Đơn Tối Thiểu (VNĐ)</label>
            <input asp-for="MinOrderValue" type="number" class="form-control rounded-3" title="Nhập giá trị đơn hàng tối thiểu" aria-label="Giá trị đơn tối thiểu" />
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="StartDate" class="form-label fw-bold small">Ngày Bắt Đầu</label>
                <input asp-for="StartDate" type="datetime-local" class="form-control rounded-3" value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" title="Chọn thời gian bắt đầu" aria-label="Thời gian bắt đầu" required />
            </div>
            <div class="col-md-6">
                <label asp-for="EndDate" class="form-label fw-bold small">Ngày Kết Thúc</label>
                <input asp-for="EndDate" type="datetime-local" class="form-control rounded-3" value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" title="Chọn thời gian kết thúc" aria-label="Thời gian kết thúc" required />
            </div>
        </div>

        <button type="submit" class="btn btn-primary-gradient btn-lg w-100 py-3 font-heading fw-bold shadow-lg" title="Lưu thay đổi mã khuyến mãi" aria-label="Lưu thay đổi mã khuyến mãi">
            CẬP NHẬT MÃ KHUYẾN MÃI
        </button>
    </form>
</div>

@{
    ViewData["Title"] = "Phương Thức Thanh Toán";
}

<div class="container my-5 py-3">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="bi bi-house me-1"></i> Trang Chủ</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Phương Thức Thanh Toán</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white p-4 p-md-5">
        <div class="text-center mb-5">
            <span class="badge bg-warning-subtle text-warning-emphasis fw-bold px-3 py-2 rounded-pill mb-2">AN TOÀN & DỄ DÀNG</span>
            <h1 class="fw-bold font-heading display-6 text-dark mb-3">💳 Hướng Dẫn & Phương Thức Thanh Toán</h1>
            <p class="text-muted mx-auto" style="max-width:650px;">FASHION STORE hỗ trợ linh hoạt nhiều cổng thanh toán hiện đại nhất Việt Nam để bạn mua sắm tiện lợi.</p>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-light border text-center h-100">
                    <i class="bi bi-cash-stack text-success display-4 mb-3 d-block"></i>
                    <h5 class="fw-bold text-dark mb-2">1. Thanh Toán COD (Tiền Mặt)</h5>
                    <p class="small text-muted m-0">Nhận hàng, kiểm tra sản phẩm ưng ý trước khi thanh toán tiền mặt trực tiếp cho nhân viên giao hàng.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-light border text-center h-100">
                    <i class="bi bi-qr-code-scan text-primary display-4 mb-3 d-block"></i>
                    <h5 class="fw-bold text-dark mb-2">2. Chuyển Khoản VietQR Nhanh</h5>
                    <p class="small text-muted m-0">Quét mã VietQR tự động điền số tiền và nội dung đơn hàng qua tất cả ứng dụng Ngân Hàng (MB, VCB, Techcombank...).</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-light border text-center h-100">
                    <i class="bi bi-credit-card-2-front text-danger display-4 mb-3 d-block"></i>
                    <h5 class="fw-bold text-dark mb-2">3. Cổng PayOS / Thẻ Visa/Master</h5>
                    <p class="small text-muted m-0">Thanh toán an toàn bảo mật chuẩn quốc tế qua cổng ngân hàng liên kết trực tiếp PayOS.</p>
                </div>
            </div>
        </div>
    </div>
</div>

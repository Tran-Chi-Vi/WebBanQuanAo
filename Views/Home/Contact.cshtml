@{
    ViewData["Title"] = "Liên Hệ - FASHION STORE";
}

<!-- ====== CONTACT HERO ====== -->
<section class="container-fluid px-0">
    <div style="background:linear-gradient(135deg,#0f172a 0%,#1e1b4b 50%,#311042 100%);padding:5rem 2rem 4rem;text-align:center;position:relative;overflow:hidden;">
        <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%236366f1\' fill-opacity=\'0.05\'%3E%3Ccircle cx=\'30\' cy=\'30\' r=\'4\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
        <div class="position-relative">
            <span class="badge px-3 py-2 rounded-pill mb-3" style="background:rgba(255,255,255,0.1);color:rgba(255,255,255,0.85);backdrop-filter:blur(8px);letter-spacing:0.08em;font-size:0.78rem;">📍 CHÚNG TÔI Ở ĐÂY</span>
            <h1 class="display-5 fw-bold text-white mb-3">LIÊN HỆ VỚI CHÚNG TÔI</h1>
            <p class="text-white lead mb-0" style="opacity:0.72;max-width:520px;margin:0 auto;">Chúng tôi luôn sẵn sàng hỗ trợ bạn. Hãy liên hệ với chúng tôi bất cứ lúc nào bạn cần!</p>
        </div>
    </div>
</section>

<!-- ====== CONTACT INFO CARDS ====== -->
<section class="container my-5">
    <div class="row g-4 mb-5">
        <div class="col-md-4 reveal reveal-delay-1">
            <div class="contact-info-card h-100">
                <div class="contact-icon-wrap">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <h5 class="fw-bold mb-2">Địa Chỉ Cửa Hàng</h5>
                <p class="text-muted small mb-0">123 Đường Thời Trang, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh</p>
                <small class="text-success fw-semibold mt-2 d-block"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i> Đang Mở Cửa</small>
            </div>
        </div>
        <div class="col-md-4 reveal reveal-delay-2">
            <div class="contact-info-card h-100">
                <div class="contact-icon-wrap" style="background:linear-gradient(135deg,#d1fae5,#a7f3d0);">
                    <i class="bi bi-telephone-fill" style="color:#10b981;"></i>
                </div>
                <h5 class="fw-bold mb-2">Điện Thoại & Hotline</h5>
                <p class="text-muted small mb-0">
                    <strong class="text-dark">Hotline:</strong> <a href="tel:19006789" class="text-decoration-none text-dark fw-semibold">1900 6789</a><br>
                    <strong class="text-dark">Zalo:</strong> <a href="#" class="text-decoration-none text-dark">0359 876 543</a>
                </p>
                <small class="text-muted mt-2 d-block"><i class="bi bi-clock me-1"></i> 8:00 – 22:00 (T2 – CN)</small>
            </div>
        </div>
        <div class="col-md-4 reveal reveal-delay-3">
            <div class="contact-info-card h-100">
                <div class="contact-icon-wrap" style="background:linear-gradient(135deg,#fef3c7,#fde68a);">
                    <i class="bi bi-envelope-fill" style="color:#f59e0b;"></i>
                </div>
                <h5 class="fw-bold mb-2">Email Hỗ Trợ</h5>
                <p class="text-muted small mb-0">
                    <strong class="text-dark">Hỗ trợ:</strong> <a href="mailto:support@fashionstore.vn" class="text-decoration-none text-primary">support@fashionstore.vn</a><br>
                    <strong class="text-dark">Kinh doanh:</strong> <a href="mailto:business@fashionstore.vn" class="text-decoration-none text-primary">business@fashionstore.vn</a>
                </p>
                <small class="text-muted mt-2 d-block"><i class="bi bi-reply me-1"></i> Phản hồi trong 24 giờ</small>
            </div>
        </div>
    </div>

    <!-- ====== GOOGLE MAP + CONTACT FORM ====== -->
    <div class="row g-4">
        <!-- Google Map -->
        <div class="col-lg-7 reveal reveal-left">
            <h3 class="fw-bold font-heading mb-3">Bản Đồ Đường Đến Cửa Hàng</h3>
            <div class="map-container">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.4674827180086!2d106.69614831531737!3d10.776504892322152!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f4670702e31%3A0xa5777fb3d5f7b5f3!2zUXXhuq1uIDEsIEjhu5MgQ2jDrSBNaW5o!5e0!3m2!1svi!2svn!4v1627800000000!5m2!1svi!2svn"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="Bản đồ Fashion Store - Quận 1 TP.HCM">
                </iframe>
            </div>
            <!-- Store Hours -->
            <div class="mt-4 p-4 rounded-4 border bg-white">
                <h6 class="fw-bold mb-3"><i class="bi bi-clock-fill text-primary me-2"></i>Giờ Mở Cửa</h6>
                <div class="row g-2 small">
                    <div class="col-6 d-flex justify-content-between">
                        <span class="text-muted">Thứ Hai – Thứ Sáu:</span>
                        <strong>8:00 – 22:00</strong>
                    </div>
                    <div class="col-6 d-flex justify-content-between">
                        <span class="text-muted">Thứ Bảy – Chủ Nhật:</span>
                        <strong>9:00 – 21:00</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="col-lg-5 reveal reveal-right">
            <div class="p-4 p-md-5 bg-white rounded-4 border shadow-sm h-100">
                <h3 class="fw-bold font-heading mb-1">Gửi Tin Nhắn</h3>
                <p class="text-muted small mb-4">Điền thông tin bên dưới, chúng tôi sẽ liên hệ lại sớm nhất!</p>

                <form id="contactForm" novalidate>
                    <div class="mb-3">
                        <label class="form-label">Họ và Tên <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="Nguyễn Văn An" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Địa Chỉ Email <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" placeholder="email@example.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số Điện Thoại</label>
                        <input type="tel" class="form-control" placeholder="0909 123 456" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Chủ Đề</label>
                        <select class="form-select">
                            <option value="" disabled selected>-- Chọn chủ đề cần hỗ trợ --</option>
                            <option>Tư vấn sản phẩm</option>
                            <option>Hỗ trợ đơn hàng</option>
                            <option>Chính sách đổi trả</option>
                            <option>Hợp tác kinh doanh</option>
                            <option>Khác</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Nội Dung Tin Nhắn <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="4" placeholder="Hãy mô tả vấn đề hoặc câu hỏi của bạn..." required style="resize:none;"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary-gradient w-100 py-3 fw-bold rounded-3">
                        <i class="bi bi-send-fill me-2"></i> Gửi Tin Nhắn
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
    document.getElementById('contactForm')?.addEventListener('submit', function(e) {
        e.preventDefault();
        showToast('Cảm ơn bạn đã liên hệ! Chúng tôi sẽ phản hồi trong vòng 24 giờ. 😊', 'success');
        this.reset();
    });
    </script>
}

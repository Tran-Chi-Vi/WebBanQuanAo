@using WEBBANQUANAO.Models.Entities
@{
    ViewData["Title"] = "Trang Chủ - Fashion Store | Thời Trang Cao Cấp";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var brands = ViewBag.Brands as List<Brand> ?? new List<Brand>();
    var newArrivals = ViewBag.NewArrivals as List<Product> ?? new List<Product>();
    var bestsellers = ViewBag.Bestsellers as List<Product> ?? new List<Product>();
    var activePromotions = ViewBag.ActivePromotions as List<Promotion> ?? new List<Promotion>();

    string[] catIcons = { "bi-shirt", "bi-bag", "bi-bootstrap", "bi-umbrella", "bi-gem", "bi-watch", "bi-sunglasses", "bi-handbag" };
}

<!-- ====== HERO BANNER ====== -->
<section class="container-fluid px-3 px-md-4 pt-3.5 pb-2">
    <div class="hero-banner reveal position-relative overflow-hidden">
        <!-- Interactive Canvas Particle Mesh -->
        <canvas id="heroParticleCanvas" style="position:absolute;top:0;left:0;width:100%;height:100%;z-index:1;pointer-events:none;opacity:0.65;"></canvas>

        <!-- Decorative Orbs -->
        <div class="hero-orb hero-orb-1" style="z-index:2;"></div>
        <div class="hero-orb hero-orb-2" style="z-index:2;"></div>
        <div class="hero-orb hero-orb-3" style="z-index:2;"></div>

        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <span class="badge mb-3 px-3 py-1.5 rounded-pill fw-bold" style="background:rgba(255,255,255,0.12);color:rgba(255,255,255,0.9);backdrop-filter:blur(8px);letter-spacing:0.08em;font-size:0.78rem;">✨ SUMMER COLLECTION 2026</span>
                <h1 class="fw-bold mb-3 text-white hero-main-heading">
                    BẬT PHONG CÁCH
                    <div class="hero-typewriter-wrapper">
                        <span id="heroTypewriter" class="text-warning hero-typewriter-text">ĐỊNH GU THỜI TRANG</span>
                    </div>
                </h1>
                <p class="mb-4 text-white" style="opacity:0.9;max-width:520px;font-size:1.02rem;line-height:1.6;">Khám phá bộ sưu tập quần áo & phụ kiện mới nhất với thiết kế hiện đại, chất liệu cao cấp và ưu đãi đặc quyền lên tới <strong class="text-warning">50%</strong>.</p>
                <div class="d-flex flex-wrap gap-3 mb-2">
                    <a href="/Product" class="btn btn-primary-gradient d-flex align-items-center gap-2 shadow-lg rounded-4 px-4 py-3 fw-bold" style="font-size:0.98rem;" title="Xem tất cả bộ sưu tập thời trang" aria-label="Khám phá ngay bộ sưu tập sản phẩm">
                        <i class="bi bi-bag-fill fs-5"></i> Khám Phá Ngay
                    </a>
                    <a href="/Product?sortBy=popular" class="btn rounded-4 d-flex align-items-center gap-2 px-4 py-3 fw-bold" style="font-size:0.98rem;background:rgba(255,255,255,0.15);color:white;border:1.5px solid rgba(255,255,255,0.3);backdrop-filter:blur(10px);transition:all 0.25s ease;" title="Xem danh sách sản phẩm bán chạy nhất" aria-label="Xem sản phẩm bán chạy nhất" onmouseenter="this.style.background='white';this.style.color='#0f172a';" onmouseleave="this.style.background='rgba(255,255,255,0.15)';this.style.color='white';">
                        <i class="bi bi-fire text-warning fs-5"></i> Bán Chạy Nhất
                    </a>
                </div>

                <!-- Stats Row -->
                <div class="d-flex flex-wrap gap-4 mt-4 pt-3" style="border-top:1px solid rgba(255,255,255,0.12);">
                    <div class="text-white">
                        <div class="fw-bold font-heading fs-4 text-warning" data-counter="5000">5000+</div>
                        <div style="font-size:0.8rem;opacity:0.75;">Sản phẩm mẫu</div>
                    </div>
                    <div class="text-white">
                        <div class="fw-bold font-heading fs-4 text-warning" data-counter="12000">12K+</div>
                        <div style="font-size:0.8rem;opacity:0.75;">Khách hàng tin dùng</div>
                    </div>
                    <div class="text-white">
                        <div class="fw-bold font-heading fs-4 text-warning" data-counter="98">98%</div>
                        <div style="font-size:0.8rem;opacity:0.75;">Hài lòng chất lượng</div>
                    </div>
                    <div class="text-white">
                        <div class="fw-bold font-heading fs-4 text-warning">⭐ 4.9/5</div>
                        <div style="font-size:0.8rem;opacity:0.75;">Đánh giá trung bình</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ====== ACTIVE PROMOTIONS ====== -->
@if (activePromotions.Any())
{
    <section class="container my-4">
        <div class="row g-3">
            @foreach (var promo in activePromotions)
            {
                <div class="col-md-6 reveal">
                    <div class="promo-card d-flex align-items-center justify-content-between p-3.5 bg-body rounded-4 shadow-sm border" style="transition: transform 0.3s ease;">
                        <div class="d-flex align-items-center gap-3">
                            <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#e0e7ff,#f3e8ff);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="bi bi-ticket-perforated-fill fs-3 text-primary"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-body mb-1">
                                    Mã Ưu Đãi: <span class="badge font-monospace px-2.5 py-1 text-white" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);font-size:0.92rem;">@promo.Code</span>
                                </div>
                                <small class="text-muted">
                                    @(promo.DiscountType == DiscountType.Percentage ? $"Giảm {promo.DiscountValue}%" : $"Giảm {promo.DiscountValue:N0}đ") — Đơn từ <strong class="text-body">@promo.MinOrderValue.ToString("N0")đ</strong>
                                </small>
                            </div>
                        </div>
                        <button type="button" onclick="copyPromoCode('@promo.Code')" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold shadow-sm" title="Bấm để sao chép mã" aria-label="Sao chép mã giảm giá vào bộ nhớ tạm">
                            <i class="bi bi-clipboard-check me-1"></i> Sao Chép
                        </button>
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- ====== FEATURED CATEGORIES ====== -->
<section class="container my-5" id="featuredCategoriesSection">
    <div class="text-center mb-4 reveal">
        <h2 class="fw-bold font-heading display-6 text-body mb-2" title="Xem danh mục thời trang nổi bật tại Fashion Store">DANH MỤC THỜI TRANG NỔI BẬT</h2>
        <p class="text-muted" style="max-width:550px;margin:0 auto;font-size:0.95rem;">Bấm chọn danh mục yêu thích để khám phá nhanh các sản phẩm đang có sẵn</p>
    </div>

    <div class="row g-3">
        @{ int catIdx = 0; }
        @foreach (var cat in categories)
        {
            string icon = catIdx < catIcons.Length ? catIcons[catIdx] : "bi-bag";
            catIdx++;
            <div class="col-6 col-sm-4 col-md-3 col-lg-3 reveal">
                <div class="category-card p-4 rounded-4 bg-white text-center shadow-sm border border-light" onclick="onCategoryCardClick(@cat.CategoryId, 'cat-@cat.CategoryId')" tabindex="0" role="button" aria-label="Xem danh mục @cat.CategoryName" style="cursor:pointer;transition:all 0.3s ease;">
                    <div class="category-card-icon mx-auto mb-3" style="width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,#e0e7ff,#f1f5f9);display:flex;align-items:center;justify-content:center;color:#6366f1;font-size:1.6rem;">
                        <i class="bi @icon"></i>
                    </div>
                    <h6 class="fw-bold text-body m-0 mb-1" style="font-size:1rem;">@cat.CategoryName</h6>
                    <small class="text-muted" style="font-size:0.8rem;">@cat.SubCategories.Count bộ sưu tập con</small>
                </div>
            </div>
        }
    </div>
</section>

<!-- ====== PRODUCT SHOWCASE ====== -->
<section class="container my-5" id="productShowcaseSection">
    <!-- Header & Category Filter Tabs -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 reveal">
        <div>
            <h2 class="fw-bold font-heading display-6 text-body mb-1" title="Khám phá bộ sưu tập thời trang hàng đầu tại Fashion Store">BỘ SƯU TẬP THỜI TRANG HÀNG ĐẦU</h2>
            <p class="text-muted small m-0">Tuyển chọn các thiết kế mới nhất và bán chạy nhất dành cho bạn</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2" id="homeFilterTabs" style="max-width:100%;">
            <button type="button" class="btn btn-primary rounded-pill px-3 py-2 fw-bold text-nowrap filter-tab-btn active" style="font-size:0.85rem;" data-filter="all" onclick="filterHomeProducts('all', this)" title="Xem tất cả sản phẩm thời trang" aria-label="Lọc tất cả sản phẩm thời trang">
                Tất Cả
            </button>
            @foreach (var cat in categories)
            {
                <button type="button" class="btn btn-light rounded-pill px-3 py-2 fw-semibold text-nowrap filter-tab-btn" style="font-size:0.85rem;border:1.5px solid #e2e8f0;" data-filter="cat-@cat.CategoryId" onclick="filterHomeProducts('cat-@cat.CategoryId', this)">
                    @cat.CategoryName
                </button>
            }
        </div>
    </div>

    <!-- Products Grid -->
    <div class="row g-3 g-md-4" id="homeProductsGrid">
        @{
            var userFavs = ViewBag.FavoriteProductIds as List<int> ?? new List<int>();
        }
        @foreach (var p in newArrivals.Concat(bestsellers).DistinctBy(x => x.ProductId).Take(16))
        {
            var firstVar = p.Variants.FirstOrDefault();
            var mainImg = p.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? p.Images.FirstOrDefault()?.ImageUrl ?? "/images/no-image.png";
            var isNew = (DateTime.Now - p.CreatedAt).TotalDays <= 30;
            var isFav = userFavs.Contains(p.ProductId);
            <div class="col-6 col-sm-4 col-md-4 col-lg-3 product-item-wrapper cat-@p.CategoryId reveal">
                <div class="product-card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white d-flex flex-column" style="transition:transform 0.3s ease, box-shadow 0.3s ease;">
                    <div class="product-card-img-wrapper position-relative overflow-hidden" style="padding-top:125%;background:#f8fafc;">
                        @if (isNew)
                        {
                            <span class="position-absolute top-0 start-0 m-3 badge bg-danger rounded-pill fw-bold" style="font-size:0.72rem;letter-spacing:0.05em;z-index:2;">NEW</span>
                        }
                        else
                        {
                            <span class="position-absolute top-0 start-0 m-3 badge bg-dark text-white rounded-pill fw-semibold" style="font-size:0.72rem;z-index:2;">@p.Gender</span>
                        }
                        <button onclick="toggleFavoriteAjax(@p.ProductId, this)" class="btn btn-sm btn-light rounded-circle shadow-sm position-absolute top-0 end-0 m-3 d-flex align-items-center justify-content-center @(isFav ? "active" : "")" style="width:34px;height:34px;z-index:2;" title="Thêm yêu thích">
                            <i class="bi @(isFav ? "bi-heart-fill" : "bi-heart") text-danger" style="@(isFav ? "color:#ec4899;" : "")"></i>
                        </button>
                        <a href="/Product/Details/@p.ProductId" class="position-absolute top-0 start-0 w-100 h-100">
                            <img src="@mainImg" alt="@p.ProductName" loading="lazy" style="width:100%;height:100%;object-fit:cover;transition:transform 0.5s ease;" class="product-img" />
                        </a>
                    </div>
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <small class="text-primary fw-semibold mb-1" style="font-size:0.78rem;">@p.Category?.CategoryName</small>
                        <a href="/Product/Details/@p.ProductId" class="text-decoration-none text-dark">
                            <h6 class="fw-bold mb-2 text-truncate-2 font-heading" style="font-size:0.95rem;line-height:1.4;height:2.7em;" title="@p.ProductName">@p.ProductName</h6>
                        </a>
                        <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                            <div>
                                <span class="fw-bold text-indigo fs-6 font-monospace" style="color:#6366f1;">@p.BasePrice.ToString("N0")đ</span>
                            </div>
                            <button type="button" onclick="addToCartAjax(@(firstVar?.VariantId ?? 0), 1, this)"
                                    class="btn btn-primary-gradient rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                                    style="width:36px;height:36px;padding:0;flex-shrink:0;" title="Thêm vào giỏ hàng">
                                <i class="bi bi-cart-plus fs-6"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- View All Button -->
    <div class="text-center mt-5 reveal">
        <a href="/Product" class="btn btn-primary-gradient btn-lg px-5 rounded-pill shadow-lg fw-bold font-heading">
            <i class="bi bi-grid-3x3-gap-fill me-2"></i> XEM TOÀN BỘ SẢN PHẨM
        </a>
    </div>
</section>

<!-- ====== AI RECOMMENDATION SECTION ====== -->
@{
    var personalizedRecs = ViewBag.PersonalizedRecommendations as List<Product> ?? new List<Product>();
}
@if (personalizedRecs.Any())
{
    <section class="container my-5 reveal">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1.5 rounded-pill mb-2" style="font-size:0.78rem;">✨ AI RECOMMENDATION ENGINE</span>
                <h3 class="fw-bold font-heading m-0 text-dark">Gợi Ý Sản Phẩm Dành Riêng Cho Bạn</h3>
            </div>
            <a href="/Product" class="text-primary text-decoration-none fw-semibold small">Xem tất cả <i class="bi bi-arrow-right"></i></a>
        </div>

        <div class="row g-3 g-md-4">
            @foreach (var p in personalizedRecs.Take(4))
            {
                var firstVar = p.Variants.FirstOrDefault();
                var mainImg = p.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? p.Images.FirstOrDefault()?.ImageUrl ?? "/images/no-image.png";
                <div class="col-6 col-md-3" data-rec-source="personalized_ai" data-rec-block="homepage_personalized" data-product-id="@p.ProductId">
                    <div class="product-card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white d-flex flex-column" style="transition:transform 0.3s ease, box-shadow 0.3s ease;">
                        <div class="product-card-img-wrapper position-relative overflow-hidden" style="padding-top:125%;background:#f8fafc;">
                            <span class="position-absolute top-0 start-0 m-3 badge bg-primary text-white rounded-pill fw-bold" style="font-size:0.72rem;z-index:2;">GỢI Ý AI</span>
                            <a href="/Product/Details/@p.ProductId" class="position-absolute top-0 start-0 w-100 h-100">
                                <img src="@mainImg" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=500&auto=format&fit=crop&q=80';" alt="@p.ProductName" loading="lazy" style="width:100%;height:100%;object-fit:cover;" class="product-img" />
                            </a>
                        </div>
                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <small class="text-primary fw-semibold mb-1" style="font-size:0.78rem;">@p.Category?.CategoryName</small>
                            <a href="/Product/Details/@p.ProductId" class="text-decoration-none text-dark">
                                <h6 class="fw-bold mb-2 text-truncate-2 font-heading" style="font-size:0.95rem;line-height:1.4;height:2.7em;" title="@p.ProductName">@p.ProductName</h6>
                            </a>
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                                <span class="fw-bold text-indigo fs-6 font-monospace" style="color:#6366f1;">@p.BasePrice.ToString("N0")đ</span>
                                <button type="button" onclick="addToCartAjax(@(firstVar?.VariantId ?? 0), 1, this)" class="btn btn-primary-gradient rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width:36px;height:36px;padding:0;" title="Thêm vào giỏ hàng">
                                    <i class="bi bi-cart-plus fs-6"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- ====== CUSTOMER REVIEWS & SOCIAL PROOF ====== -->
<section class="container my-5">
    <div class="text-center mb-4 reveal">
        <h2 class="fw-bold font-heading display-6 text-dark mb-2">KHÁCH HÀNG NÓI GÌ VỀ FASHION STORE</h2>
        <p class="text-muted" style="max-width:500px;margin:0 auto;font-size:0.95rem;">Hơn 12,000+ khách hàng đã tin tưởng lựa chọn sản phẩm và dịch vụ của chúng tôi</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4 reveal">
            <div class="p-4 bg-white rounded-4 shadow-sm border border-light h-100">
                <div class="text-warning mb-2">
                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                </div>
                <p class="text-secondary small mb-3">"Chất vải áo phông mát mịn, form dáng cực chuẩn như hình chụp. Đóng gói cẩn thận và giao hàng siêu nhanh chỉ trong 2 ngày!"</p>
                <div class="d-flex align-items-center gap-2">
                    <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:white;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:0.85rem;">N</div>
                    <div>
                        <div class="fw-bold text-body small">Nguyễn Hoàng Anh</div>
                        <small class="text-muted" style="font-size:0.75rem;">Khách hàng Gen Z - Hà Nội</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 reveal">
            <div class="p-4 bg-white rounded-4 shadow-sm border border-light h-100">
                <div class="text-warning mb-2">
                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                </div>
                <p class="text-secondary small mb-3">"Tính năng gợi ý đồ thông minh rất tiện, phối áo sơ mi với quần âu hợp mốt. Dịch vụ chăm sóc khách hàng và đổi size cực kỳ nhiệt tình."</p>
                <div class="d-flex align-items-center gap-2">
                    <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#ec4899,#f43f5e);color:white;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:0.85rem;">T</div>
                    <div>
                        <div class="fw-bold text-body small">Trần Phương Thảo</div>
                        <small class="text-muted" style="font-size:0.75rem;">Khách hàng VIP - TP. Hồ Chí Minh</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 reveal">
            <div class="p-4 bg-white rounded-4 shadow-sm border border-light h-100">
                <div class="text-warning mb-2">
                    <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                </div>
                <p class="text-secondary small mb-3">"Đã mua 3 lần ở shop, đồ bền màu không xù lông sau khi giặt máy. Mã giảm giá áp dụng mượt và có nhận hóa đơn qua Gmail rất chuyên nghiệp."</p>
                <div class="d-flex align-items-center gap-2">
                    <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#10b981,#059669);color:white;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:0.85rem;">V</div>
                    <div>
                        <div class="fw-bold text-body small">Vũ Minh Trí</div>
                        <small class="text-muted" style="font-size:0.75rem;">Khách hàng thân thiết - Đà Nẵng</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ====== BRAND STRIP ====== -->
@if (brands.Any())
{
    <section class="container my-5 pb-3">
        <div class="text-center mb-4 reveal">
            <h2 class="fw-bold font-heading display-6 text-body mb-1">ĐỐI TÁC THƯƠNG HIỆU HÀNG ĐẦU</h2>
        </div>
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-4 py-3">
            @foreach (var b in brands)
            {
                <div class="reveal">
                    @if (!string.IsNullOrEmpty(b.LogoUrl))
                    {
                        <img src="@b.LogoUrl" alt="@b.BrandName" style="height:42px;object-fit:contain;filter:grayscale(100%);opacity:0.55;transition:all 0.3s ease;" class="brand-logo" />
                    }
                    else
                    {
                        <div class="px-4 py-2 rounded-3 fw-bold text-muted" style="border:2px solid #e2e8f0;font-family:'Outfit',sans-serif;letter-spacing:-0.02em;font-size:1.1rem;" title="Thương hiệu @b.BrandName">@b.BrandName</div>
                    }
                </div>
            }
        </div>
    </section>
}

@section Scripts {
    <script>
    // Copy Promo Code function
    function copyPromoCode(code) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(code).then(() => {
                showToast(`Đã sao chép mã giảm giá: ${code}`, 'success');
            }).catch(() => {
                showToast(`Mã giảm giá: ${code}`, 'info');
            });
        } else {
            showToast(`Mã giảm giá: ${code}`, 'info');
        }
    }

    // Filter tabs
    function filterHomeProducts(filterGroup, btnElement) {
        document.querySelectorAll('#homeFilterTabs .filter-tab-btn').forEach(btn => {
            btn.className = 'btn btn-light rounded-pill px-3 py-2 fw-semibold filter-tab-btn text-nowrap';
            btn.style.fontSize = '0.85rem';
            btn.style.border = '1.5px solid #e2e8f0';
        });
        if (btnElement) {
            btnElement.className = 'btn btn-primary rounded-pill px-3 py-2 fw-bold filter-tab-btn active text-nowrap';
            btnElement.style.fontSize = '0.85rem';
            btnElement.style.border = '';
        }
        const items = document.querySelectorAll('#homeProductsGrid .product-item-wrapper');
        items.forEach((item, i) => {
            const show = filterGroup === 'all' || item.classList.contains(filterGroup);
            item.style.display = show ? '' : 'none';
            if (show) {
                item.style.opacity = '0';
                item.style.transform = 'translateY(16px)';
                setTimeout(() => {
                    item.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                    item.style.opacity = '1';
                    item.style.transform = 'translateY(0)';
                }, i * 40);
            }
        });
    }

    function onCategoryCardClick(catId, filterClass) {
        const targetBtn = document.querySelector(`#homeFilterTabs button[data-filter="${filterClass}"]`);
        if (targetBtn) {
            targetBtn.click();
            document.getElementById('productShowcaseSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
            window.location.href = `/Product?categoryId=${catId}`;
        }
    }

    // Brand logo hover effect
    document.querySelectorAll('.brand-logo').forEach(logo => {
        logo.addEventListener('mouseenter', () => {
            logo.style.filter = 'grayscale(0%)';
            logo.style.opacity = '1';
            logo.style.transform = 'scale(1.05)';
        });
        logo.addEventListener('mouseleave', () => {
            logo.style.filter = 'grayscale(100%)';
            logo.style.opacity = '0.55';
            logo.style.transform = 'scale(1)';
        });
    });
    </script>
}

@{
    ViewData["Title"] = "Hướng Dẫn Chọn Size Chuẩn";
}

<div class="container my-5 py-3">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="bi bi-house me-1"></i> Trang Chủ</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Hướng Dẫn Chọn Size</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white p-4 p-md-5">
        <div class="text-center mb-5">
            <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2 rounded-pill mb-2">BẢNG QUY ĐỔI KÍCH THƯỚC CHUẨN</span>
            <h1 class="fw-bold font-heading display-6 text-dark mb-3">📐 Hướng Dẫn Chọn Size Quần Áo</h1>
            <p class="text-muted mx-auto" style="max-width:650px;">Để lựa chọn những bộ trang phục vừa vặn và thoải mái nhất, quý khách vui lòng tham khảo bảng thông số chọn Size chuẩn dưới đây từ FASHION STORE.</p>
        </div>

        <div class="row g-4 mb-5">
            <!-- Bảng Size Nam -->
            <div class="col-lg-6">
                <div class="p-4 rounded-4 bg-light border border-light h-100">
                    <h4 class="fw-bold text-primary mb-3"><i class="bi bi-gender-male me-2"></i> Bảng Size Thời Trang Nam</h4>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-primary">
                                <tr>
                                    <th>Size</th>
                                    <th>Chiều cao (cm)</th>
                                    <th>Cân nặng (kg)</th>
                                    <th>Vòng ngực (cm)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td class="fw-bold">S</td><td>155 - 164</td><td>48 - 56</td><td>84 - 88</td></tr>
                                <tr><td class="fw-bold">M</td><td>165 - 172</td><td>57 - 65</td><td>89 - 93</td></tr>
                                <tr><td class="fw-bold">L</td><td>173 - 178</td><td>66 - 74</td><td>94 - 98</td></tr>
                                <tr><td class="fw-bold">XL</td><td>179 - 184</td><td>75 - 83</td><td>99 - 104</td></tr>
                                <tr><td class="fw-bold">XXL</td><td>185 - 190</td><td>84 - 92</td><td>105 - 110</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Bảng Size Nữ -->
            <div class="col-lg-6">
                <div class="p-4 rounded-4 bg-light border border-light h-100">
                    <h4 class="fw-bold text-danger mb-3"><i class="bi bi-gender-female me-2"></i> Bảng Size Thời Trang Nữ</h4>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-danger">
                                <tr>
                                    <th>Size</th>
                                    <th>Chiều cao (cm)</th>
                                    <th>Cân nặng (kg)</th>
                                    <th>Vòng eo (cm)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td class="fw-bold">S</td><td>150 - 156</td><td>40 - 46</td><td>60 - 64</td></tr>
                                <tr><td class="fw-bold">M</td><td>157 - 162</td><td>47 - 53</td><td>65 - 69</td></tr>
                                <tr><td class="fw-bold">L</td><td>163 - 168</td><td>54 - 60</td><td>70 - 74</td></tr>
                                <tr><td class="fw-bold">XL</td><td>169 - 174</td><td>61 - 67</td><td>75 - 79</td></tr>
                                <tr><td class="fw-bold">XXL</td><td>175 - 180</td><td>68 - 75</td><td>80 - 85</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="alert alert-info rounded-4 border-0 d-flex align-items-center gap-3 p-4 m-0">
            <i class="bi bi-info-circle-fill fs-2 text-info flex-shrink-0"></i>
            <div>
                <h6 class="fw-bold mb-1">💡 Lời khuyên chọn size từ Chuyên Gia:</h6>
                <p class="small m-0 text-muted">Nếu chiều cao và cân nặng của bạn thuộc 2 size khác nhau, quý khách nên chọn **Size lớn hơn** để có cảm giác mặc thoải mái hoặc liên hệ hotline <strong class="text-dark">1900 6789</strong> để tư vấn chi tiết.</p>
            </div>
        </div>
    </div>
</div>

@model Order
@{
    ViewData["Title"] = $"Chi Tiết Đơn Hàng #{Model.OrderNumber}";
    string qrCodeUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=220x220&data={Uri.EscapeDataString($"https://fashionstore-zjc7.onrender.com/Order/Track/{Model.OrderGuid}")}";
}

<div class="container my-4" style="max-width: 750px;">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
        <!-- Header Banner -->
        <div class="bg-primary text-white p-4 text-center position-relative" style="background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);">
            <div class="badge bg-white text-primary fw-bold px-3 py-1.5 rounded-pill mb-2 shadow-sm fs-6">
                PH phiếu GIAO HÀNG & TRA CỨU ĐƠN HÀNG
            </div>
            <h3 class="fw-bold font-monospace mb-1">#@Model.OrderNumber</h3>
            <p class="mb-0 opacity-75 small">Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
        </div>

        <div class="card-body p-4">
            <!-- QR Code Box -->
            <div class="text-center p-3 mb-4 rounded-4 bg-light border border-dashed border-primary">
                <div class="small fw-bold text-primary text-uppercase mb-2"><i class="bi bi-qr-code-scan me-1"></i> Mã QR Xác Thực Đơn Hàng (Shipper Quét Nhanh)</div>
                <div class="bg-white p-2 d-inline-block rounded-3 shadow-sm border">
                    <img src="@qrCodeUrl" alt="Mã QR Đơn Hàng" style="width: 180px; height: 180px;" class="d-block" />
                </div>
                <div class="small text-muted mt-2">Mã Tra Cứu: <strong class="font-monospace text-dark">@Model.OrderGuid</strong></div>
            </div>

            <!-- Order Status & COD Info -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border h-100">
                        <small class="text-muted fw-bold d-block mb-1">TRẠNG THÁI GIAO HÀNG</small>
                        <div class="fs-6">
                            @switch (Model.Status)
                            {
                                case OrderStatus.Pending:
                                    <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill"><i class="bi bi-hourglass-split me-1"></i> Đang Xử Lý</span>
                                    break;
                                case OrderStatus.Shipping:
                                    <span class="badge bg-info text-white fs-6 px-3 py-2 rounded-pill"><i class="bi bi-truck me-1"></i> Đang Giao Hàng</span>
                                    break;
                                case OrderStatus.Completed:
                                    <span class="badge bg-success text-white fs-6 px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Đã Hoàn Thành</span>
                                    break;
                                case OrderStatus.Cancelled:
                                    <span class="badge bg-danger text-white fs-6 px-3 py-2 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i> Đã Hủy</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary fs-6">Chờ Xét Duyệt</span>
                                    break;
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border h-100">
                        <small class="text-muted fw-bold d-block mb-1">TIỀN THU HỘ (COD) / THANH TOÁN</small>
                        @if (Model.Payment?.Status == PaymentStatus.Success)
                        {
                            <div class="fw-bold text-success fs-5"><i class="bi bi-shield-check me-1"></i> ĐÃ THANH TOÁN (0đ COD)</div>
                        }
                        else
                        {
                            <div class="fw-bold text-danger fs-4">CẦN THU HỘ COD: @Model.TotalAmount.ToString("N0")đ</div>
                        }
                    </div>
                </div>
            </div>

            <!-- Recipient Information & One-Tap Phone Call -->
            <div class="card p-3 border rounded-3 bg-white mb-4">
                <h6 class="fw-bold font-heading mb-3 text-dark"><i class="bi bi-geo-alt-fill text-danger me-2"></i> THÔNG TIN NGƯỜI NHẬN HÀNG</h6>
                @if (Model.Address != null)
                {
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-2">
                        <div>
                            <div class="fw-bold text-dark fs-5">@Model.Address.RecipientName</div>
                            <div class="text-muted"><i class="bi bi-telephone me-1"></i> SĐT: <strong class="text-dark font-monospace">@Model.Address.Phone</strong></div>
                        </div>
                        <a href="tel:@Model.Address.Phone" class="btn btn-success fw-bold shadow-sm rounded-pill px-3 py-2">
                            <i class="bi bi-telephone-outbound-fill me-2"></i> Gọi Điện Nhận Hàng
                        </a>
                    </div>
                    <div class="small text-secondary bg-light p-2 rounded-2 mt-2 border">
                        <strong>Địa chỉ giao:</strong> @Model.Address.DetailAddress, @Model.Address.Ward, @Model.Address.District, @Model.Address.Province
                    </div>
                }
                else
                {
                    <div class="text-muted">Khách hàng: @Model.User?.FullName (@Model.User?.Email)</div>
                }
            </div>

            <!-- Product Items List -->
            <h6 class="fw-bold font-heading mb-3 text-dark"><i class="bi bi-bag-check-fill text-primary me-2"></i> CHI TIẾT SẢN PHẨM ĐANG GIAO (@Model.OrderDetails.Sum(d => d.Quantity) SP)</h6>
            <div class="table-responsive mb-4">
                <table class="table align-middle border">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 70px;">Hình ảnh</th>
                            <th>Sản Phẩm</th>
                            <th class="text-center" style="width: 80px;">SL</th>
                            <th class="text-end">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            var p = item.Variant?.Product;
                            var img = p?.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? p?.Images.FirstOrDefault()?.ImageUrl ?? "/images/no-image.png";
                            decimal itemTotal = item.UnitPrice * item.Quantity;

                            <tr>
                                <td>
                                    <img src="@img" alt="@p?.ProductName" class="rounded-3 border" style="width: 56px; height: 56px; object-fit: cover;" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark mb-1">@p?.ProductName</div>
                                    <span class="badge bg-light text-dark border me-1">Size: @item.Variant?.Size</span>
                                    <span class="badge bg-light text-dark border">Màu: @item.Variant?.Color</span>
                                </td>
                                <td class="text-center fw-bold fs-6">x@item.Quantity</td>
                                <td class="text-end fw-bold text-primary">@itemTotal.ToString("N0")đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Final Summary -->
            <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 border">
                <span class="fw-bold text-dark fs-6">TỔNG GIÁ TRỊ ĐƠN HÀNG:</span>
                <span class="fw-bold text-primary fs-4">@Model.TotalAmount.ToString("N0")đ</span>
            </div>
        </div>

        <div class="card-footer bg-white text-center py-3 border-top text-muted small">
            © FASHION STORE Logistics System - Hệ thống xác thực mã QR tự động.
        </div>
    </div>
</div>

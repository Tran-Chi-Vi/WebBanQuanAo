@model Order
@{
    ViewData["Title"] = $"Phiếu Giao Hàng #{Model.OrderNumber}";
    DateTime vnOrderDate = Model.OrderDate.AddHours(7);
    string orderDateStr = vnOrderDate.ToString("dd/MM/yyyy HH:mm");
    string deliveryCompletedTimeStr = Model.Payment?.PaidAt.HasValue == true
        ? Model.Payment.PaidAt.Value.AddHours(7).ToString("dd/MM/yyyy HH:mm:ss")
        : "Đang vận chuyển";

    string trackUrl = $"https://fashionstore-zjc7.onrender.com/Order/Track/{Model.OrderGuid}";
    string qrCodeUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=220x220&data={Uri.EscapeDataString(trackUrl)}";
    bool autoExit = TempData["AutoRedirectExit"] != null;
}

<style>
    /* Theme-Adaptive High-Contrast System for Light & Dark Mode */
    .track-page-container {
        --track-card-bg: #ffffff;
        --track-card-border: #e2e8f0;
        --track-box-bg: #f8fafc;
        --track-box-border: #e2e8f0;
        --track-text-main: #0f172a;
        --track-text-muted: #64748b;
        --track-table-head-bg: #f1f5f9;
        --track-table-head-color: #334155;
        --track-action-box-bg: #eff6ff;
        --track-action-box-border: #3b82f6;
    }

    /* Dark Mode Theme Enforcement */
    [data-bs-theme="dark"] .track-page-container,
    body.theme-dark .track-page-container,
    .theme-dark .track-page-container {
        --track-card-bg: #0f172a;
        --track-card-border: #334155;
        --track-box-bg: #1e293b;
        --track-box-border: #334155;
        --track-text-main: #f8fafc;
        --track-text-muted: #cbd5e1;
        --track-table-head-bg: #334155;
        --track-table-head-color: #f1f5f9;
        --track-action-box-bg: #1e1b4b;
        --track-action-box-border: #6366f1;
    }

    .track-wrapper {
        background-color: var(--track-card-bg);
        color: var(--track-text-main);
        border: 1px solid var(--track-card-border);
        border-radius: 24px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
        overflow: hidden;
    }

    .track-header {
        background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);
        padding: 26px 20px;
        color: #ffffff;
    }

    .track-box {
        background-color: var(--track-box-bg);
        border: 1px solid var(--track-box-border);
        border-radius: 16px;
        padding: 18px;
        color: var(--track-text-main);
    }

    .track-text-muted {
        color: var(--track-text-muted) !important;
    }

    .track-text-main {
        color: var(--track-text-main) !important;
    }

    .track-table-head {
        background-color: var(--track-table-head-bg) !important;
        color: var(--track-table-head-color) !important;
    }

    .shipper-action-box {
        background-color: var(--track-action-box-bg);
        border: 2px solid var(--track-action-box-border);
        border-radius: 18px;
        padding: 20px;
    }

    .status-pill {
        font-weight: 700;
        font-size: 13.5px;
        padding: 6px 14px;
        border-radius: 30px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    /* Highlighted Vibrant Action Buttons */
    .btn-shipper-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }
    @@media (max-width: 576px) {
        .btn-shipper-group {
            grid-template-columns: 1fr;
        }
    }
    .btn-shipper-act {
        min-height: 52px;
        font-size: 14px;
        font-weight: 700;
        border-radius: 12px;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        text-transform: uppercase;
        letter-spacing: 0.3px;
        padding: 10px 16px;
        width: 100%;
    }
    .btn-shipper-success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #ffffff !important;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.4);
    }
    .btn-shipper-success:hover {
        background: linear-gradient(135deg, #059669 0%, #047857 100%);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
    }
    .btn-shipper-danger {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: #ffffff !important;
        box-shadow: 0 4px 14px rgba(239, 68, 68, 0.4);
    }
    .btn-shipper-danger:hover {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(239, 68, 68, 0.5);
    }
</style>

<div class="container py-4 track-page-container" style="max-width: 760px;">
    
    <!-- Instant Exit Script (If Shipper just submitted an action) -->
    @if (autoExit)
    {
        <script>
            window.location.href = '/';
        </script>
    }

    @if (TempData["SuccessMessage"] != null && !autoExit)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4 shadow-sm fw-bold fs-6" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null && !autoExit)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4 shadow-sm fw-bold fs-6" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null && !autoExit)
    {
        <div class="alert alert-info alert-dismissible fade show rounded-4 mb-4 shadow-sm fw-bold fs-6" role="alert">
            <i class="bi bi-info-circle-fill me-2 fs-5"></i> @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="track-wrapper">
        <!-- Header -->
        <div class="track-header text-center">
            <span class="badge bg-white bg-opacity-10 text-white border border-white border-opacity-20 fw-bold px-3 py-1.5 rounded-pill mb-2 fs-6">
                PHIẾU XÁC NHẬN GIAO HÀNG LOGISTICS
            </span>
            <h2 class="fw-bold font-monospace mb-1 text-white">#@Model.OrderNumber</h2>
            <div class="small text-white-50">
                🕒 Thời gian đặt: <strong class="text-white">@orderDateStr (Giờ Việt Nam)</strong>
            </div>
        </div>

        <div class="p-4">

            <!-- Customer Confirmation Action Box (If order is WaitingForCustomer) -->
            @if (Model.Status == OrderStatus.WaitingForCustomer)
            {
                <div class="track-box border-warning bg-warning-subtle text-dark text-center mb-4">
                    <h5 class="fw-bold mb-2"><i class="bi bi-person-check-fill text-warning me-2 fs-4"></i> CHỜ KHÁCH HÀNG XÁC NHẬN NHẬN HÀNG</h5>
                    <p class="small text-dark opacity-75 mb-3">Shipper vừa báo chưa giao thành công lần @Model.DeliveryAttemptCount/3. Nếu bạn là khách hàng mua đơn này, hãy bấm vào nút bên dưới để xác nhận sẵn sàng nhận hàng lần tiếp theo!</p>
                    <div class="col-md-9 mx-auto">
                        <a href="/Order/CustomerConfirmDelivery/@Model.OrderGuid" class="btn btn-warning btn-lg w-100 fw-bold py-3 shadow rounded-3 text-dark fs-6">
                            <i class="bi bi-check2-circle me-2 fs-5"></i> 👉 BẤM VÀO ĐÂY ĐỂ XÁC NHẬN NHẬN HÀNG LẦN @(Model.DeliveryAttemptCount + 1)
                        </a>
                    </div>
                </div>
            }

            <!-- Locked State Banner (If Completed or Cancelled) -->
            @if (Model.Status == OrderStatus.Completed || Model.Status == OrderStatus.Cancelled)
            {
                <div class="p-3.5 rounded-4 mb-4 text-center @(Model.Status == OrderStatus.Completed ? "bg-success-subtle border border-success text-success" : "bg-danger-subtle border border-danger text-danger")">
                    <div class="fs-5 fw-bold mb-1">
                        @if (Model.Status == OrderStatus.Completed)
                        {
                            <span>🔒 ĐÃ KHÓA THAO TÁC - ĐƠN HÀNG ĐÃ GIAO THÀNH CÔNG</span>
                        }
                        else
                        {
                            <span>🔒 ĐÃ KHÓA THAO TÁC - ĐƠN HÀNG ĐÃ BỊ HỦY & HOÀN KHO</span>
                        }
                    </div>
                    <small class="d-block opacity-75">Mọi thao tác thay đổi đã được hoàn tất lúc: <strong>@deliveryCompletedTimeStr</strong></small>
                </div>
            }

            <!-- Shipper Action Card (Only active when NOT Completed & NOT Cancelled & NOT AutoExiting) -->
            @if (Model.Status != OrderStatus.Completed && Model.Status != OrderStatus.Cancelled && !autoExit)
            {
                <div class="shipper-action-box text-center mb-4">
                    <h6 class="fw-bold text-primary text-uppercase mb-1"><i class="bi bi-shield-lock-fill me-1"></i> BẢNG XÁC NHẬN CHÍNH THỨC CHO SHIPPER</h6>
                    <p class="small track-text-muted mb-3">Vui lòng chọn trạng thái chính xác sau khi gặp và giao hàng trực tiếp cho khách:</p>

                    <div class="btn-shipper-group">
                        <form asp-controller="Order" asp-action="ShipperUpdateStatus" method="post" class="d-inline" onsubmit="return handleShipperConfirm(this, 'Bạn có chắc chắn xác nhận GIAO HÀNG THÀNH CÔNG tới khách hàng?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderGuid" value="@Model.OrderGuid" />
                            <input type="hidden" name="actionType" value="confirm_success" />
                            <button type="submit" class="btn-shipper-act btn-shipper-success">
                                <i class="bi bi-check-circle-fill fs-5"></i> GIAO THÀNH CÔNG
                            </button>
                        </form>

                        <form asp-controller="Order" asp-action="ShipperUpdateStatus" method="post" class="d-inline" onsubmit="return handleShipperConfirm(this, 'Báo GIAO HÀNG THẤT BẢI cho lần này? (Hệ thống sẽ gửi email cho Khách bấm xác nhận giao lại)')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderGuid" value="@Model.OrderGuid" />
                            <input type="hidden" name="actionType" value="fail_attempt" />
                            <button type="submit" class="btn-shipper-act btn-shipper-danger">
                                <i class="bi bi-x-circle-fill fs-5"></i> BÁO GIAO THẤT BẢI (Lần @(Model.DeliveryAttemptCount + 1)/3)
                            </button>
                        </form>
                    </div>
                </div>
            }

            <!-- Status Overview Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="track-box h-100">
                        <div class="small track-text-muted fw-bold text-uppercase mb-2">TRẠNG THÁI GIAO HÀNG</div>
                        <div class="mb-2">
                            @switch (Model.Status)
                            {
                                case OrderStatus.Pending:
                                    <span class="status-pill bg-warning-subtle text-warning border border-warning">
                                        <i class="bi bi-hourglass-split"></i> Đang Xử Lý Khởi Tạo
                                    </span>
                                    break;
                                case OrderStatus.Shipping:
                                    <span class="status-pill bg-info-subtle text-info border border-info">
                                        <i class="bi bi-truck"></i> Đang Trên Đường Giao
                                    </span>
                                    break;
                                case OrderStatus.WaitingForCustomer:
                                    <span class="status-pill bg-warning-subtle text-warning border border-warning">
                                        <i class="bi bi-clock-history"></i> Chờ Khách Xác Nhận Giao Lại
                                    </span>
                                    break;
                                case OrderStatus.Completed:
                                    <span class="status-pill bg-success-subtle text-success border border-success">
                                        <i class="bi bi-check-circle-fill"></i> Đã Giao Thành Công
                                    </span>
                                    break;
                                case OrderStatus.Cancelled:
                                    <span class="status-pill bg-danger-subtle text-danger border border-danger">
                                        <i class="bi bi-x-circle-fill"></i> Đã Hủy & Hoàn Kho
                                    </span>
                                    break;
                                default:
                                    <span class="status-pill bg-secondary-subtle text-secondary">Chờ Duyệt</span>
                                    break;
                            }
                        </div>
                        <small class="track-text-muted font-monospace d-block">Số lần phát hàng: <strong class="track-text-main">@Model.DeliveryAttemptCount / 3 lần</strong></small>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="track-box h-100">
                        <div class="small track-text-muted fw-bold text-uppercase mb-2">TIỀN THU HỘ (COD) / THANH TOÁN</div>
                        @if (Model.Payment?.Status == PaymentStatus.Success)
                        {
                            <div class="fw-bold text-success fs-5"><i class="bi bi-shield-check me-1"></i> ĐÃ THANH TOÁN (0đ COD)</div>
                        }
                        else
                        {
                            <div class="fw-bold text-danger fs-4">CẦN THU HỘ COD: @Model.TotalAmount.ToString("N0")đ</div>
                        }
                    </div>
                </div>
            </div>

            <!-- Recipient Info & 1-Tap Phone Call -->
            <div class="track-box mb-4">
                <h6 class="fw-bold font-heading mb-3 text-uppercase track-text-main"><i class="bi bi-geo-alt-fill text-danger me-2"></i> THÔNG TIN NGƯỜI NHẬN HÀNG</h6>
                @if (Model.Address != null)
                {
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-2">
                        <div>
                            <div class="fw-bold fs-5 track-text-main">@Model.Address.RecipientName</div>
                            <div class="track-text-muted"><i class="bi bi-telephone me-1"></i> SĐT Khách: <strong class="font-monospace fs-6 track-text-main">@Model.Address.Phone</strong></div>
                        </div>
                        <a href="tel:@Model.Address.Phone" class="btn btn-success fw-bold shadow-sm rounded-pill px-4 py-2.5">
                            <i class="bi bi-telephone-outbound-fill me-2"></i> GỌI KHÁCH NHẬN HÀNG
                        </a>
                    </div>
                    <div class="small p-3 rounded-3 mt-2 border fw-semibold track-box">
                        📍 <strong>Địa chỉ nhận hàng:</strong> @Model.Address.DetailAddress, @Model.Address.Ward, @Model.Address.District, @Model.Address.Province
                    </div>
                }
                else
                {
                    <div class="track-text-muted">Khách hàng: @Model.User?.FullName (@Model.User?.Email)</div>
                }
            </div>

            <!-- Items Table -->
            <h6 class="fw-bold font-heading mb-3 text-uppercase track-text-main"><i class="bi bi-bag-check-fill text-primary me-2"></i> CHI TIẾT SẢN PHẨM GIAO (@Model.OrderDetails.Sum(d => d.Quantity) sản phẩm)</h6>
            <div class="table-responsive mb-4">
                <table class="table align-middle border rounded-3 overflow-hidden">
                    <thead>
                        <tr class="track-table-head">
                            <th style="width: 70px;">Hình ảnh</th>
                            <th>Sản Phẩm</th>
                            <th class="text-center" style="width: 90px;">Số Lượng</th>
                            <th class="text-end pe-3">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody class="track-text-main">
                        @foreach (var item in Model.OrderDetails)
                        {
                            var p = item.Variant?.Product;
                            var img = p?.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? p?.Images.FirstOrDefault()?.ImageUrl ?? "/images/no-image.png";
                            decimal itemTotal = item.UnitPrice * item.Quantity;

                            <tr>
                                <td>
                                    <img src="@img" alt="@p?.ProductName" class="rounded-3 border shadow-sm" style="width: 56px; height: 56px; object-fit: cover;" />
                                </td>
                                <td>
                                    <div class="fw-bold mb-1 fs-6 track-text-main">@p?.ProductName</div>
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border me-1">Size: @item.Variant?.Size</span>
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border">Màu: @item.Variant?.Color</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary px-3 py-2 fs-6 rounded-pill">x @item.Quantity</span>
                                </td>
                                <td class="text-end pe-3 fw-bold text-primary fs-6">@itemTotal.ToString("N0")đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Total Amount Summary -->
            <div class="d-flex justify-content-between align-items-center p-3.5 track-box">
                <span class="fw-bold fs-6 track-text-main">TỔNG CỘNG ĐƠN HÀNG:</span>
                <span class="fw-bold text-primary fs-4">@Model.TotalAmount.ToString("N0")đ</span>
            </div>

        </div>

        <div class="text-center py-3 border-top track-text-muted small">
            © FASHION STORE Logistics System - Hệ thống xác thực & cập nhật giao hàng thông minh.
        </div>
    </div>
</div>

<script>
    function handleShipperConfirm(formEl, msg) {
        if (confirm(msg)) {
            const btn = formEl.querySelector('button[type="submit"]');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang xử lý...';
            }
            return true;
        }
        return false;
    }
</script>

@model CartViewModel
@{
    ViewData["Title"] = "Giỏ Hàng Của Bạn";
}

<div class="container my-4">
    <h2 class="fw-bold font-heading mb-4"><i class="bi bi-cart3 text-primary me-2"></i> GIỎ HÀNG CỦA BẠN</h2>

    @if (!Model.Items.Any())
    {
        <div class="text-center py-5 bg-body rounded-4 shadow-sm border p-4">
            <i class="bi bi-cart-x display-3 text-primary opacity-75 mb-2 d-inline-block" title="Giỏ hàng trống"></i>
            <h4 class="fw-bold font-heading text-body mt-2">Giỏ hàng của bạn đang trống</h4>
            <p class="text-muted small">Hãy chọn mua thêm các sản phẩm thời trang phong cách từ cửa hàng nhé!</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary-gradient px-4 py-2.5 rounded-pill fw-bold shadow-sm mt-2">Khám Phá Sản Phẩm</a>
        </div>
    }
    else
    {
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <!-- Items Container -->
            <div class="col-lg-8">
                <div class="card p-3 p-md-4 border-0 shadow-sm rounded-4 bg-white">
                    <!-- Top Select All Bar -->
                    <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
                        <div class="form-check m-0 d-flex align-items-center gap-2">
                            <input type="checkbox" id="selectAllCartMaster" class="form-check-input" checked onchange="toggleSelectAllCart(this.checked)" style="width:20px;height:20px;cursor:pointer;" title="Bấm để chọn hoặc bỏ chọn tất cả sản phẩm trong giỏ hàng" aria-label="Chọn tất cả sản phẩm trong giỏ hàng" />
                            <label for="selectAllCartMaster" class="form-check-label fw-bold text-body fs-6" style="cursor:pointer;">
                                Chọn Tất Cả (<span id="totalItemCountLabel">@Model.Items.Count</span> Sản Phẩm)
                            </label>
                        </div>
                        <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2 rounded-pill small">
                            Đã chọn: <span id="selectedCountBadge">@Model.Items.Count</span> SP
                        </span>
                    </div>

                    <!-- Desktop Table View -->
                    <div class="d-none d-md-block table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40px;"></th>
                                    <th>Sản Phẩm</th>
                                    <th>Đơn Giá</th>
                                    <th style="width: 130px;">Số Lượng</th>
                                    <th>Thành Tiền</th>
                                    <th style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr id="cart-row-@item.VariantId">
                                        <td>
                                            <input type="checkbox" class="form-check-input cart-item-checkbox cart-item-check-desk" data-variant-id="@item.VariantId" data-price="@item.Price" checked onchange="syncAndRecalculateCartSelection(@item.VariantId, this.checked)" style="width:18px;height:18px;cursor:pointer;" />
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@item.ImageUrl" alt="@item.ProductName" class="rounded-3 shadow-sm flex-shrink-0" style="width: 60px; height: 60px; object-fit: cover;" />
                                                <div>
                                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="fw-bold text-dark text-decoration-none d-block text-truncate" style="max-width:220px;">@item.ProductName</a>
                                                    <small class="text-muted">Size: @item.Size | Màu: @item.Color</small>
                                                    <div class="small text-info font-monospace" id="stock-hint-@item.VariantId">(Tồn kho: @item.AvailableStock SP)</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-bold">@item.Price.ToString("N0")đ</td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <button type="button" class="btn btn-outline-secondary fw-bold" onclick="adjustCartQty(@item.VariantId, -1, @item.AvailableStock)">-</button>
                                                <input type="number" id="qty-@item.VariantId" 
                                                       class="form-control text-center font-monospace fw-bold px-1" 
                                                       value="@item.Quantity" 
                                                       min="1" 
                                                       max="@item.AvailableStock" 
                                                       onchange="handleQtyInputBlur(@item.VariantId, this.value, @item.AvailableStock)" />
                                                <button type="button" class="btn btn-outline-secondary fw-bold" onclick="adjustCartQty(@item.VariantId, 1, @item.AvailableStock)">+</button>
                                            </div>
                                        </td>
                                        <td class="fw-bold text-primary" id="item-total-@item.VariantId">@item.TotalPrice.ToString("N0")đ</td>
                                        <td>
                                            <button onclick="removeCartItem(@item.VariantId)" class="btn btn-sm btn-outline-danger border-0 rounded-circle" title="Xóa">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Mobile Cards View -->
                    <div class="d-md-none d-flex flex-column gap-3">
                        @foreach (var item in Model.Items)
                        {
                            <div id="cart-card-@item.VariantId" class="card p-3 border rounded-4 shadow-sm bg-white position-relative">
                                <div class="d-flex align-items-center gap-3">
                                    <input type="checkbox" class="form-check-input cart-item-checkbox cart-item-check-mob me-1" data-variant-id="@item.VariantId" data-price="@item.Price" checked onchange="syncAndRecalculateCartSelection(@item.VariantId, this.checked)" style="width:20px;height:20px;cursor:pointer;flex-shrink:0;" />
                                    <img src="@item.ImageUrl" alt="@item.ProductName" class="rounded-3 shadow-sm flex-shrink-0" style="width: 76px; height: 76px; object-fit: cover;" />
                                    <div style="flex: 1; min-width: 0;">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="fw-bold text-dark text-decoration-none lh-sm mb-1 d-block pe-2" style="font-size: 0.95rem;">@item.ProductName</a>
                                            <button onclick="removeCartItem(@item.VariantId)" class="btn btn-sm text-danger p-0 border-0 flex-shrink-0" title="Xóa">
                                                <i class="bi bi-trash-fill fs-5"></i>
                                            </button>
                                        </div>
                                        <div class="small text-muted mb-1">Size: <strong>@item.Size</strong> | Màu: <strong>@item.Color</strong></div>
                                        <div class="small text-info font-monospace mb-2">(Tồn kho: @item.AvailableStock SP)</div>
                                        
                                        <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                            <div>
                                                <span class="small text-muted d-block" style="font-size:0.75rem;">Đơn giá: @item.Price.ToString("N0")đ</span>
                                                <span class="fw-bold text-primary fs-6" id="item-total-mob-@item.VariantId">@item.TotalPrice.ToString("N0")đ</span>
                                            </div>
                                            <div class="input-group input-group-sm" style="width: 105px;">
                                                <button type="button" class="btn btn-outline-secondary fw-bold" onclick="adjustCartQty(@item.VariantId, -1, @item.AvailableStock)">-</button>
                                                <input type="number" id="qty-mob-@item.VariantId" 
                                                       class="form-control text-center font-monospace fw-bold px-1" 
                                                       value="@item.Quantity" 
                                                       min="1" 
                                                       max="@item.AvailableStock" 
                                                       onchange="handleQtyInputBlur(@item.VariantId, this.value, @item.AvailableStock)" />
                                                <button type="button" class="btn btn-outline-secondary fw-bold" onclick="adjustCartQty(@item.VariantId, 1, @item.AvailableStock)">+</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Order Summary & Promo Code -->
            <div class="col-lg-4">
                <div class="card p-4 border-0 shadow-sm rounded-4 bg-body sticky-cart-summary">
                    <h5 class="fw-bold font-heading mb-3">TỔNG ĐƠN HÀNG</h5>

                    <!-- Promo Code Form -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">MÃ GIẢM GIÁ (PROMO CODE)</label>
                        <div class="input-group">
                            <input type="text" id="promoCodeInput" class="form-control text-uppercase" placeholder="Nhập mã..." value="@Model.AppliedPromoCode" aria-label="Nhập mã ưu đãi hoặc mã giảm giá" />
                            <button onclick="applyPromoAjax()" class="btn btn-outline-primary fw-bold" type="button" title="Bấm để áp dụng mã giảm giá">Áp Dụng</button>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.PromoMessage))
                        {
                            <div class="small text-success fw-bold mt-1"><i class="bi bi-check-circle-fill me-1"></i> @Model.PromoMessage</div>
                        }
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính (<span id="summarySelectedCount">@Model.Items.Count</span> SP):</span>
                        <span id="summarySubTotal" class="fw-bold">@Model.SubTotal.ToString("N0")đ</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 text-success">
                        <span>Giảm giá:</span>
                        <span id="summaryDiscount" class="fw-bold">-@Model.DiscountAmount.ToString("N0")đ</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-4 fs-5">
                        <span class="fw-bold">Tổng thanh toán:</span>
                        <span id="summaryFinalTotal" class="fw-bold text-primary">@Model.FinalTotal.ToString("N0")đ</span>
                    </div>

                    <button type="button" id="proceedCheckoutBtn" onclick="proceedSelectedCheckout()" class="btn btn-primary-gradient btn-lg w-100 py-3 font-heading fw-bold shadow-lg" title="Bấm để tiến hành đặt các sản phẩm đã chọn trong giỏ hàng" aria-label="Tiến hành đặt hàng các sản phẩm đã chọn">
                        TIẾN HÀNH ĐẶT HÀNG (<span id="btnSelectedCount">@Model.Items.Count</span>) <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                    <div id="noSelectionWarning" class="small text-danger fw-bold text-center mt-2" style="display:none;">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Vui lòng chọn ít nhất 1 sản phẩm để thanh toán!
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function toggleSelectAllCart(isChecked) {
            const allCheckboxes = document.querySelectorAll('.cart-item-checkbox');
            allCheckboxes.forEach(cb => cb.checked = isChecked);
            const masterCb = document.getElementById('selectAllCartMaster');
            if (masterCb) masterCb.checked = isChecked;
            recalculateSelectedCartTotals();
        }

        function syncAndRecalculateCartSelection(variantId, isChecked) {
            const deskCb = document.querySelector(`.cart-item-check-desk[data-variant-id="${variantId}"]`);
            const mobCb = document.querySelector(`.cart-item-check-mob[data-variant-id="${variantId}"]`);
            if (deskCb) deskCb.checked = isChecked;
            if (mobCb) mobCb.checked = isChecked;

            const allDeskCbs = Array.from(document.querySelectorAll('.cart-item-check-desk'));
            const allChecked = allDeskCbs.length > 0 && allDeskCbs.every(cb => cb.checked);
            const masterCb = document.getElementById('selectAllCartMaster');
            if (masterCb) masterCb.checked = allChecked;

            recalculateSelectedCartTotals();
        }

        function recalculateSelectedCartTotals() {
            let totalSub = 0;
            let countSelected = 0;

            const deskCbs = document.querySelectorAll('.cart-item-check-desk');
            deskCbs.forEach(cb => {
                if (cb.checked) {
                    const variantId = cb.getAttribute('data-variant-id');
                    const qtyInput = document.getElementById(`qty-${variantId}`) || document.getElementById(`qty-mob-${variantId}`);
                    const qty = parseInt(qtyInput?.value) || 1;
                    const price = parseFloat(cb.getAttribute('data-price')) || 0;
                    totalSub += price * qty;
                    countSelected++;
                }
            });

            document.getElementById('summarySelectedCount').textContent = countSelected;
            document.getElementById('selectedCountBadge').textContent = countSelected;
            document.getElementById('btnSelectedCount').textContent = countSelected;

            const checkoutBtn = document.getElementById('proceedCheckoutBtn');
            const warningEl = document.getElementById('noSelectionWarning');

            if (countSelected === 0) {
                if (checkoutBtn) {
                    checkoutBtn.disabled = true;
                    checkoutBtn.classList.add('opacity-50');
                }
                if (warningEl) warningEl.style.display = 'block';
                document.getElementById('summarySubTotal').textContent = '0đ';
                document.getElementById('summaryDiscount').textContent = '-0đ';
                document.getElementById('summaryFinalTotal').textContent = '0đ';
            } else {
                if (checkoutBtn) {
                    checkoutBtn.disabled = false;
                    checkoutBtn.classList.remove('opacity-50');
                }
                if (warningEl) warningEl.style.display = 'none';

                // Realtime SubTotal & FinalTotal display
                document.getElementById('summarySubTotal').textContent = totalSub.toLocaleString('vi-VN') + 'đ';
                
                // Keep promo/tier discount proportions or calculate live
                const rawDiscountText = document.getElementById('summaryDiscount').textContent.replace(/[^0-9]/g, '');
                const rawDiscount = parseFloat(rawDiscountText) || 0;
                const finalTotal = Math.max(0, totalSub - rawDiscount);
                document.getElementById('summaryFinalTotal').textContent = finalTotal.toLocaleString('vi-VN') + 'đ';
            }
        }

        function proceedSelectedCheckout() {
            const selectedIds = [];
            const deskCbs = document.querySelectorAll('.cart-item-check-desk');
            deskCbs.forEach(cb => {
                if (cb.checked) {
                    selectedIds.push(cb.getAttribute('data-variant-id'));
                }
            });

            if (selectedIds.length === 0) {
                showToast('Vui lòng chọn ít nhất 1 sản phẩm để thanh toán!', 'warning');
                return;
            }

            const paramStr = selectedIds.join(',');
            window.location.href = `/Order/Checkout?selectedVariantIds=${paramStr}`;
        }

        function adjustCartQty(variantId, delta, maxStock) {
            const input = document.getElementById(`qty-${variantId}`) || document.getElementById(`qty-mob-${variantId}`);
            if (!input) return;
            let currentVal = parseInt(input.value) || 1;
            let newVal = currentVal + delta;
            handleQtyInputBlur(variantId, newVal, maxStock);
        }

        function handleQtyInputBlur(variantId, val, maxStock) {
            let targetVal = parseInt(val) || 1;

            if (targetVal > maxStock) {
                targetVal = maxStock;
                showToast(`Số lượng tồn kho sản phẩm này chỉ còn ${maxStock} SP!`, 'warning');
            }

            if (targetVal < 1) targetVal = 1;

            const deskInput = document.getElementById(`qty-${variantId}`);
            const mobInput = document.getElementById(`qty-mob-${variantId}`);
            if (deskInput) deskInput.value = targetVal;
            if (mobInput) mobInput.value = targetVal;

            sendUpdateQuantity(variantId, targetVal);
        }

        function getCsrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        function sendUpdateQuantity(variantId, newQty) {
            fetch('/Cart/UpdateQuantity', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': getCsrfToken()
                },
                body: `variantId=${variantId}&quantity=${newQty}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (newQty <= 0) {
                        document.getElementById(`cart-row-${variantId}`)?.remove();
                        document.getElementById(`cart-card-${variantId}`)?.remove();
                    } else {
                        const deskInput = document.getElementById(`qty-${variantId}`);
                        const mobInput = document.getElementById(`qty-mob-${variantId}`);
                        if (deskInput) deskInput.value = newQty;
                        if (mobInput) mobInput.value = newQty;

                        const formattedTotal = data.itemTotal.toLocaleString('vi-VN') + 'đ';
                        const deskTotal = document.getElementById(`item-total-${variantId}`);
                        const mobTotal = document.getElementById(`item-total-mob-${variantId}`);
                        if (deskTotal) deskTotal.textContent = formattedTotal;
                        if (mobTotal) mobTotal.textContent = formattedTotal;
                    }
                    recalculateSelectedCartTotals();
                    if (typeof updateCartCountBadge === 'function') {
                        updateCartCountBadge(data.cartCount);
                    }
                } else {
                    showToast(data.message, 'error');
                }
            })
            .catch(err => console.error(err));
        }

        function removeCartItem(variantId) {
            fetch('/Cart/RemoveItem', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': getCsrfToken()
                },
                body: `variantId=${variantId}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById(`cart-row-${variantId}`)?.remove();
                    document.getElementById(`cart-card-${variantId}`)?.remove();
                    recalculateSelectedCartTotals();
                    if (typeof updateCartCountBadge === 'function') {
                        updateCartCountBadge(data.cartCount);
                    }
                    showToast(data.message, 'info');
                    if (data.cartCount === 0) location.reload();
                }
            });
        }

        function applyPromoAjax() {
            const code = document.getElementById('promoCodeInput').value.trim();
            fetch('/Cart/ApplyPromotion', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': getCsrfToken()
                },
                body: `promoCode=${encodeURIComponent(code)}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    location.reload();
                } else {
                    showToast(data.message, 'error');
                }
            });
        }
    </script>
}

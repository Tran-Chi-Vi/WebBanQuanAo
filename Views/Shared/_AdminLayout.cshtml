<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- CSS Libraries -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

    <!-- Admin CSS -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <!-- Admin Sidebar -->
    <aside class="admin-sidebar">
        <div class="admin-sidebar-header d-flex align-items-center gap-2">
            <i class="bi bi-shield-lock-fill text-warning fs-3"></i>
            <span>ADMIN<span class="text-primary">PORTAL</span></span>
        </div>
        <nav class="mt-4">
            <div class="admin-nav-item">
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill fs-5"></i>
                    <span>Tổng Quan (Dashboard)</span>
                </a>
            </div>
            <div class="admin-nav-item">
                <a class="admin-nav-link" asp-area="Admin" asp-controller="ProductManagement" asp-action="Index">
                    <i class="bi bi-box-seam-fill fs-5"></i>
                    <span>Quản Lý Sản Phẩm</span>
                </a>
            </div>
            <div class="admin-nav-item">
                <a class="admin-nav-link" asp-area="Admin" asp-controller="CategoryBrand" asp-action="Categories">
                    <i class="bi bi-tags-fill fs-5"></i>
                    <span>Danh Mục & Thương Hiệu</span>
                </a>
            </div>
            <div class="admin-nav-item">
                <a class="admin-nav-link" asp-area="Admin" asp-controller="OrderManagement" asp-action="Index">
                    <i class="bi bi-cart-check-fill fs-5"></i>
                    <span>Quản Lý Đơn Hàng</span>
                </a>
            </div>
            <div class="admin-nav-item">
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Promotion" asp-action="Index">
                    <i class="bi bi-ticket-perforated-fill fs-5"></i>
                    <span>Mã Khuyến Mãi</span>
                </a>
            </div>
            <div class="admin-nav-item">
                <a class="admin-nav-link" asp-area="Admin" asp-controller="User" asp-action="Index">
                    <i class="bi bi-people-fill fs-5"></i>
                    <span>Quản Lý Người Dùng</span>
                </a>
            </div>
            <div class="admin-nav-item">
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Apriori" asp-action="Index">
                    <i class="bi bi-diagram-3-fill fs-5"></i>
                    <span>Thuật Toán Apriori</span>
                </a>
            </div>
            <div class="admin-nav-item">
                <a class="admin-nav-link text-info" asp-area="Admin" asp-controller="Analytics" asp-action="Index">
                    <i class="bi bi-cpu-fill fs-5"></i>
                    <span>Phân Tích AI & ML</span>
                </a>
            </div>
            <hr class="mx-3 my-4 border-secondary opacity-25" />
            <div class="admin-nav-item">
                <a class="admin-nav-link text-warning" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shop fs-5"></i>
                    <span>Về Trang Bán Hàng</span>
                </a>
            </div>
        </nav>
    </aside>

    <!-- Admin Main Content -->
    <div class="admin-content">
        <!-- Top Navbar -->
        <header class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
            <div>
                <h4 class="m-0 font-heading fw-bold">@ViewData["Title"]</h4>
                <small class="text-muted">Hệ thống quản trị cửa hàng thời trang</small>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2 bg-white px-3 py-2 rounded-3 border">
                    <i class="bi bi-person-circle text-primary fs-5"></i>
                    <span class="fw-bold">@User.FindFirst("FullName")?.Value</span>
                    <span class="badge bg-danger ms-1">Admin</span>
                </div>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            </div>
        </header>

        <!-- Dynamic Body -->
        @RenderBody()
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                showToast("@TempData["SuccessMessage"]", 'success');
            });
        </script>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                showToast("@TempData["ErrorMessage"]", 'error');
            });
        </script>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                showToast("@TempData["InfoMessage"]", 'info');
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model Product
@{
    ViewData["Title"] = Model.ProductName + " | Fashion Store";
    var aprioriRecs = ViewBag.AprioriRecommendations as List<Product> ?? new List<Product>();
    var personalizedRecs = ViewBag.PersonalizedRecommendations as List<Product> ?? new List<Product>();
    var reviews = Model.Reviews.OrderByDescending(r => r.CreatedAt).ToList();
    double avgRating = reviews.Any() ? reviews.Average(r => r.Rating) : 5.0;
    var mainImage = Model.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? Model.Images.FirstOrDefault()?.ImageUrl ?? "/images/no-image.png";

    var sizes = Model.Variants.Select(v => v.Size).Distinct().ToList();
    var colors = Model.Variants.Select(v => v.Color).Distinct().ToList();
    var firstVariant = Model.Variants.FirstOrDefault();
}

<div class="container my-4 my-md-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-decoration-none text-muted">@Model.Category?.CategoryName</a></li>
            <li class="breadcrumb-item active fw-semibold text-dark" aria-current="page">@Model.ProductName</li>
        </ol>
    </nav>

    <!-- Product Main View Section -->
    <div class="row g-4 g-lg-5 mb-5">
        <!-- Image Gallery Column -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-3 bg-light position-relative" style="aspect-ratio:4/3;max-height:500px;">
                <img id="mainProductImg" src="@mainImage" alt="@Model.ProductName" onerror="this.onerror=null;this.src='/images/no-image.png';" class="w-100 h-100 object-fit-cover transition-all" style="transition:transform 0.4s ease;" />
            </div>

            <!-- Thumbnail Slider -->
            @if (Model.Images.Count > 1)
            {
                <div class="d-flex gap-2.5 overflow-auto pb-2">
                    @foreach (var img in Model.Images)
                    {
                        var isMain = img.ImageUrl == mainImage;
                        <div class="thumbnail-wrapper rounded-3 overflow-hidden border p-0.5 cursor-pointer @(isMain ? "border-primary border-2" : "border-light")" style="width:76px;height:76px;flex-shrink:0;cursor:pointer;transition:all 0.25s ease;" onclick="changeMainImage('@img.ImageUrl', this)">
                            <img src="@img.ImageUrl" alt="thumb" class="w-100 h-100 object-fit-cover rounded-2" />
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Details & Selectors Column -->
        <div class="col-lg-6">
            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                <span class="badge bg-primary-light text-primary border border-primary-subtle rounded-pill px-3 py-1.5 fw-semibold" style="font-size:0.8rem;">@Model.Category?.CategoryName</span>
                <span class="badge bg-light text-dark border rounded-pill px-3 py-1.5 fw-semibold" style="font-size:0.8rem;">Thương hiệu: @Model.Brand?.BrandName</span>
            </div>

            <h1 class="fw-bold font-heading mb-2 text-dark" style="font-size:1.85rem;line-height:1.3;">@Model.ProductName</h1>

            <!-- Star Rating Display -->
            <div class="d-flex align-items-center gap-2 mb-3">
                <div class="text-warning fs-6">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(avgRating))
                        {
                            <i class="bi bi-star-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-star"></i>
                        }
                    }
                </div>
                <span class="fw-bold fs-6 text-dark font-monospace">@avgRating.ToString("F1") / 5.0</span>
                <span class="text-muted small">(@reviews.Count đánh giá)</span>
            </div>

            <!-- Price Display -->
            <div class="p-3.5 bg-light rounded-4 mb-4 border border-light d-flex align-items-baseline gap-3">
                <span id="displayPrice" class="fs-2 fw-bold text-primary font-monospace" style="color:#6366f1;">@((firstVariant?.Price ?? Model.BasePrice).ToString("N0"))đ</span>
                @if (firstVariant != null && firstVariant.Price < Model.BasePrice)
                {
                    <span class="text-muted text-decoration-line-through small">@Model.BasePrice.ToString("N0")đ</span>
                }
            </div>

            <p class="text-secondary mb-4" style="line-height:1.65;font-size:0.95rem;">@Model.Description</p>

            <!-- INTERACTIVE SIZE & COLOR SELECTORS -->
            <form id="addToCartForm" class="mb-4">
                @Html.AntiForgeryToken()
                <input type="hidden" id="selectedVariantId" name="variantId" value="@(firstVariant?.VariantId ?? 0)" />

                <!-- 1. CHỌN SIZE -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold small text-body m-0">1. CHỌN KÍCH THƯỚC (SIZE):</label>
                        <span class="small text-muted font-monospace" id="sizeSelectedLabel">Size: @(firstVariant?.Size ?? "")</span>
                    </div>
                    <div class="d-flex flex-wrap gap-2" id="sizePillGroup">
                        @foreach (var sz in sizes)
                        {
                            bool isSelected = (firstVariant != null && firstVariant.Size == sz);
                            <button type="button"
                                    class="btn size-pill-btn @(isSelected ? "btn-primary shadow-sm" : "btn-outline-secondary") px-3.5 py-1.5 fw-bold"
                                    style="font-size:0.88rem;border-radius:10px;min-width:44px;"
                                    data-size="@sz"
                                    onclick="selectSize('@sz')">
                                @sz
                            </button>
                        }
                    </div>
                </div>

                <!-- 2. CHỌN MÀU SẮC -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold small text-body m-0">2. CHỌN MÀU SẮC:</label>
                        <span class="small text-muted font-monospace" id="colorSelectedLabel">Màu: @(firstVariant?.Color ?? "")</span>
                    </div>
                    <div class="d-flex flex-wrap gap-2" id="colorPillGroup">
                        @foreach (var cl in colors)
                        {
                            bool isSelected = (firstVariant != null && firstVariant.Color == cl);
                            <button type="button"
                                    class="btn color-pill-btn @(isSelected ? "btn-primary shadow-sm" : "btn-outline-secondary") px-3.5 py-1.5 fw-bold"
                                    style="font-size:0.88rem;border-radius:10px;"
                                    data-color="@cl"
                                    onclick="selectColor('@cl')">
                                @cl
                            </button>
                        }
                    </div>
                </div>

                <!-- Stock Display Alert -->
                <div id="stockAlert" class="alert alert-info rounded-3 py-2 px-3 small mb-4 d-flex align-items-center">
                    <i class="bi bi-box-seam text-primary fs-5 me-2"></i>
                    <span>Tồn kho: <strong id="stockCount" class="text-primary font-monospace fs-6">@(firstVariant?.StockQuantity ?? 0)</strong> sản phẩm có sẵn</span>
                </div>

                <!-- Quantity & Action Buttons Container (Exact 48px Height Alignment) -->
                <div class="mb-2">
                    <label class="form-label fw-bold small text-body mb-2 d-block">3. CHỌN SỐ LƯỢNG & ĐẶT HÀNG:</label>
                    <div class="d-flex align-items-stretch gap-3 flex-wrap flex-sm-nowrap">
                        <!-- Quantity Input Stepper (48px Height) -->
                        <div class="input-group" style="width: 125px; height: 48px; flex-shrink: 0;">
                            <button type="button" class="btn btn-outline-secondary fw-bold px-2.5" style="border-top-left-radius: 12px; border-bottom-left-radius: 12px;" onclick="changeQty(-1)" title="Giảm số lượng" aria-label="Giảm số lượng sản phẩm"><i class="bi bi-dash-lg"></i></button>
                            <input type="number" id="purchaseQuantity" name="quantity"
                                   class="form-control text-center fw-bold px-1 font-monospace"
                                   style="font-size: 1.05rem; height: 48px; border-color: #cbd5e1;"
                                   value="1" min="1" max="@(firstVariant?.StockQuantity ?? 100)" />
                            <button type="button" class="btn btn-outline-secondary fw-bold px-2.5" style="border-top-right-radius: 12px; border-bottom-right-radius: 12px;" onclick="changeQty(1)" title="Tăng số lượng" aria-label="Tăng số lượng sản phẩm"><i class="bi bi-plus-lg"></i></button>
                        </div>

                        <!-- Add to Cart Button (48px Height) -->
                        <button type="button" id="btnAddToCartDetails" onclick="addToCartFromDetails(this)"
                                class="btn btn-outline-primary fw-bold d-inline-flex align-items-center justify-content-center gap-2 flex-fill rounded-3"
                                style="height: 48px; font-size: 0.95rem; border-radius: 12px !important; border-width: 1.5px;">
                            <i class="bi bi-cart-plus-fill fs-5"></i>
                            <span>Thêm Vào Giỏ</span>
                        </button>

                        <!-- Buy Now Button (48px Height) -->
                        <button type="button" id="btnBuyNowDetails" onclick="buyNowFromDetails(this)"
                                class="btn btn-primary-gradient fw-bold d-inline-flex align-items-center justify-content-center gap-2 flex-fill rounded-3 shadow-lg"
                                style="height: 48px; font-size: 0.95rem; border-radius: 12px !important;">
                            <i class="bi bi-lightning-charge-fill fs-5"></i>
                            <span>MUA NGAY</span>
                        </button>
                    </div>
                </div>
            </form>

            <!-- Trust Guarantees Row -->
            <div class="row g-3 border-top pt-3 text-muted small mt-4">
                <div class="col-4 d-flex align-items-center gap-2">
                    <i class="bi bi-truck text-primary fs-5"></i>
                    <span style="font-size:0.8rem;line-height:1.3;">Giao hàng toàn quốc</span>
                </div>
                <div class="col-4 d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-counterclockwise text-primary fs-5"></i>
                    <span style="font-size:0.8rem;line-height:1.3;">Đổi trả trong 7 ngày</span>
                </div>
                <div class="col-4 d-flex align-items-center gap-2">
                    <i class="bi bi-shield-check text-primary fs-5"></i>
                    <span style="font-size:0.8rem;line-height:1.3;">Hàng chính hãng 100%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- REVIEWS & COMMENTS SECTION -->
    <div class="card p-4 p-md-5 border-0 shadow-sm rounded-4 bg-white mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h3 class="fw-bold font-heading m-0 text-body" style="font-size:1.35rem;"><i class="bi bi-star-fill text-warning me-2"></i> ĐÁNH GIÁ & BÌNH LUẬN SẢN PHẨM</h3>
                <small class="text-muted">Trung bình <strong>@avgRating.ToString("F1") / 5 sao</strong> dựa trên @reviews.Count nhận xét thực tế</small>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <button type="button" class="btn btn-outline-primary rounded-pill fw-bold px-3.5 py-2 small" data-bs-toggle="modal" data-bs-target="#reviewModal">
                    <i class="bi bi-pencil-square me-1"></i> Viết Đánh Giá Của Bạn
                </button>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary rounded-pill px-3 py-1.5 small font-heading fw-semibold">
                    Đăng nhập để viết đánh giá
                </a>
            }
        </div>

        <!-- Reviews List -->
        @if (reviews.Any())
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var r in reviews)
                {
                    <div class="p-3.5 bg-light rounded-4 border border-light">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 38px; height: 38px; font-size:0.9rem;">
                                    @(r.User?.FullName?.Substring(0, 1).ToUpper() ?? "K")
                                </div>
                                <div>
                                    <div class="fw-bold text-dark small">@r.User?.FullName <span class="badge bg-success-subtle text-success ms-1 small fw-normal">Đã mua hàng</span></div>
                                    <div class="text-warning small">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star")"></i>
                                        }
                                    </div>
                                </div>
                            </div>
                            <span class="text-muted small">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <p class="m-0 text-secondary small" style="line-height:1.6;">@r.Comment</p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted small">
                <i class="bi bi-chat-square-dots fs-1 mb-2 d-block text-secondary opacity-50"></i>
                Chưa có đánh giá nào cho sản phẩm này. Hãy là người đầu tiên trải nghiệm và để lại nhận xét!
            </div>
        }
    </div>

    <!-- PERSONALIZED RECOMMENDATIONS -->
    @if (personalizedRecs.Any())
    {
        <div class="mb-5">
            <h3 class="fw-bold font-heading text-body mb-3" style="font-size:1.25rem;">
                <i class="bi bi-eye-fill text-info me-2"></i> DÀNH RIÊNG CHO BẠN (Dựa trên lịch sử quan tâm)
            </h3>
            <div class="row g-3 g-md-4">
                @foreach (var p in personalizedRecs)
                {
                    var img = p.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? p.Images.FirstOrDefault()?.ImageUrl ?? "https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=500&auto=format&fit=crop&q=80";
                    <div class="col-6 col-md-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 product-card overflow-hidden bg-body">
                            <div style="aspect-ratio:3/4;overflow:hidden;" class="position-relative bg-light">
                                <img src="@img" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=500&auto=format&fit=crop&q=80';" class="w-100 h-100 object-fit-cover" alt="@p.ProductName" />
                            </div>
                            <div class="p-3 d-flex flex-column flex-grow-1">
                                <small class="text-muted mb-1 text-truncate d-block" style="font-size:0.75rem;">@(p.Category?.CategoryName ?? "Thời trang")</small>
                                <h6 class="fw-bold text-body text-truncate mb-2" style="font-size:0.9rem;">@p.ProductName</h6>
                                <div class="fw-bold text-primary font-monospace mt-auto" style="color:#6366f1;">@p.BasePrice.ToString("N0")đ</div>
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@p.ProductId" class="btn btn-sm btn-outline-primary w-100 rounded-3 mt-2 fw-semibold d-flex align-items-center justify-content-center gap-1 py-2" style="font-size:0.82rem;">
                                    <span>Xem chi tiết</span>
                                    <i class="bi bi-arrow-right-short fs-6"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- APRIORI CROSS-SELLING RECOMMENDATIONS -->
    @if (aprioriRecs.Any())
    {
        <div>
            <h3 class="fw-bold font-heading text-body mb-3" style="font-size:1.25rem;">
                <i class="bi bi-stars text-primary me-2"></i> SẢN PHẨM THƯỜNG ĐƯỢC MUA CÙNG
            </h3>
            <div class="row g-3 g-md-4">
                @foreach (var p in aprioriRecs)
                {
                    var img = p.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? p.Images.FirstOrDefault()?.ImageUrl ?? "https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=500&auto=format&fit=crop&q=80";
                    <div class="col-6 col-md-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 product-card overflow-hidden bg-white">
                            <div style="aspect-ratio:3/4;overflow:hidden;" class="position-relative bg-light">
                                <span class="badge bg-primary bg-gradient text-white position-absolute top-0 start-0 m-2 rounded-pill px-2.5 py-1 small fw-bold shadow-sm text-truncate" style="font-size:0.68rem; z-index:3; max-width: calc(100% - 16px);">
                                    <i class="bi bi-sparkles me-1"></i>Gợi ý mua kèm
                                </span>
                                <img src="@img" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=500&auto=format&fit=crop&q=80';" class="w-100 h-100 object-fit-cover" alt="@p.ProductName" />
                            </div>
                            <div class="p-3 d-flex flex-column flex-grow-1">
                                <small class="text-muted mb-1 text-truncate d-block" style="font-size:0.75rem;">@(p.Category?.CategoryName ?? "Thời trang")</small>
                                <h6 class="fw-bold text-dark text-truncate mb-2" style="font-size:0.9rem;">@p.ProductName</h6>
                                <div class="fw-bold text-primary font-monospace mt-auto" style="color:#6366f1;">@p.BasePrice.ToString("N0")đ</div>
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@p.ProductId" class="btn btn-sm btn-primary-gradient w-100 rounded-3 mt-2 fw-bold d-flex align-items-center justify-content-center gap-1 py-2" style="font-size:0.82rem;">
                                    <span>Xem ngay</span>
                                    <i class="bi bi-arrow-right-short fs-6"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Submit Review Modal -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold font-heading"><i class="bi bi-pencil-square text-primary me-2"></i> ĐÁNH GIÁ SẢN PHẨM</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Product" asp-action="SubmitReview" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.ProductId" />

                <div class="modal-body p-4">
                    <div class="mb-3 text-center">
                        <label class="form-label fw-bold small mb-2 d-block text-dark">Chọn Số Sao Đánh Giá (*)</label>
                        <select name="rating" class="form-select rounded-3 text-center fw-bold text-warning fs-5" required>
                            <option value="5">⭐⭐⭐⭐⭐ (5/5 Sao - Rất Tuyệt Vời)</option>
                            <option value="4">⭐⭐⭐⭐ (4/5 Sao - Hài Lòng)</option>
                            <option value="3">⭐⭐⭐ (3/5 Sao - Bình Thường)</option>
                            <option value="2">⭐⭐ (2/5 Sao - Tạm Được)</option>
                            <option value="1">⭐ (1/5 Sao - Kém)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Nhận Xét Của Bạn (*)</label>
                        <textarea name="comment" class="form-control rounded-3" rows="4" placeholder="Chia sẻ cảm nhận về chất liệu, kiểu dáng, phom dáng..." required minlength="5"></textarea>
                    </div>
                </div>

                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary-gradient rounded-pill px-4 fw-bold">GỬI ĐÁNH GIÁ</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const variantsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Variants.Select(v => new { v.VariantId, v.Size, v.Color, v.Price, v.StockQuantity })));

        let currentSelectedSize = "@(firstVariant?.Size ?? "")";
        let currentSelectedColor = "@(firstVariant?.Color ?? "")";

        function changeMainImage(url, thumbElement) {
            const mainImg = document.getElementById('mainProductImg');
            if (mainImg) mainImg.src = url;

            document.querySelectorAll('.thumbnail-wrapper').forEach(el => {
                el.className = 'thumbnail-wrapper rounded-3 overflow-hidden border p-0.5 cursor-pointer border-light';
            });
            if (thumbElement) {
                thumbElement.className = 'thumbnail-wrapper rounded-3 overflow-hidden border p-0.5 cursor-pointer border-primary border-2';
            }
        }

        function changeQty(delta) {
            const qtyInput = document.getElementById('purchaseQuantity');
            if (!qtyInput) return;
            let current = parseInt(qtyInput.value) || 1;
            let max = parseInt(qtyInput.max) || 100;
            let next = Math.max(1, Math.min(max, current + delta));
            qtyInput.value = next;
        }

        function selectSize(size) {
            currentSelectedSize = size;
            const label = document.getElementById('sizeSelectedLabel');
            if (label) label.textContent = 'Size: ' + size;

            document.querySelectorAll('#sizePillGroup .size-pill-btn').forEach(btn => {
                if (btn.getAttribute('data-size') === size) {
                    btn.className = "btn size-pill-btn btn-primary font-heading shadow-sm rounded-3 px-3.5 py-1.5 fw-bold";
                } else {
                    btn.className = "btn size-pill-btn btn-outline-secondary rounded-3 px-3.5 py-1.5 fw-bold";
                }
            });
            updateSelectedVariant();
        }

        function selectColor(color) {
            currentSelectedColor = color;
            const label = document.getElementById('colorSelectedLabel');
            if (label) label.textContent = 'Màu: ' + color;

            document.querySelectorAll('#colorPillGroup .color-pill-btn').forEach(btn => {
                if (btn.getAttribute('data-color') === color) {
                    btn.className = "btn color-pill-btn btn-primary font-heading shadow-sm rounded-3 px-3.5 py-1.5 fw-bold";
                } else {
                    btn.className = "btn color-pill-btn btn-outline-secondary rounded-3 px-3.5 py-1.5 fw-bold";
                }
            });
            updateSelectedVariant();
        }

        function updateSelectedVariant() {
            const matchedVariant = variantsData.find(v => v.Size === currentSelectedSize && v.Color === currentSelectedColor) || 
                                   variantsData.find(v => v.Size === currentSelectedSize);
            
            if (matchedVariant) {
                document.getElementById('selectedVariantId').value = matchedVariant.VariantId;
                document.getElementById('displayPrice').textContent = matchedVariant.Price.toLocaleString('vi-VN') + 'đ';
                
                const purchaseQtyInput = document.getElementById('purchaseQuantity');
                if (purchaseQtyInput) {
                    purchaseQtyInput.max = matchedVariant.StockQuantity;
                    if (parseInt(purchaseQtyInput.value) > matchedVariant.StockQuantity && matchedVariant.StockQuantity > 0) {
                        purchaseQtyInput.value = matchedVariant.StockQuantity;
                    }
                }

                const alertBox = document.getElementById('stockAlert');
                if (alertBox) {
                    if (matchedVariant.StockQuantity === 0) {
                        alertBox.className = "alert alert-danger rounded-3 py-2 px-3 small mb-4 d-flex align-items-center";
                        alertBox.innerHTML = `<i class="bi bi-x-circle-fill me-2 fs-5"></i><span>Biến thể (Size ${matchedVariant.Size} - ${matchedVariant.Color}): <strong class="fw-bold">ĐÃ HẾT HÀNG</strong></span>`;
                    } else {
                        alertBox.className = "alert alert-info rounded-3 py-2 px-3 small mb-4 d-flex align-items-center";
                        alertBox.innerHTML = `<i class="bi bi-box-seam text-primary fs-5 me-2"></i><span>Tồn kho: <strong id="stockCount" class="text-primary font-monospace fs-6">${matchedVariant.StockQuantity}</strong> sản phẩm có sẵn</span>`;
                    }
                }
            }
        }

        function getValidVariantId() {
            const variantId = parseInt(document.getElementById('selectedVariantId').value) || 0;
            if (!variantId || variantId <= 0) {
                showToast('Vui lòng chọn Size & Màu sắc sản phẩm!', 'warning');
                return 0;
            }
            return variantId;
        }

        let isDetailsActionPending = false;
        let lastDetailsClickTime = 0;
        let detailsRageClickCount = 0;

        function checkRageClickSpam() {
            const now = Date.now();
            if (now - lastDetailsClickTime < 600) {
                detailsRageClickCount++;
            } else {
                detailsRageClickCount = 1;
            }
            lastDetailsClickTime = now;

            if (detailsRageClickCount >= 3) {
                showToast('Hệ thống đã nhận lệnh xử lý của bạn, vui lòng không click liên tục!', 'info');
                return true;
            }
            return false;
        }

        function addToCartFromDetails(btnElem) {
            if (isDetailsActionPending || checkRageClickSpam()) return;

            const variantId = getValidVariantId();
            if (!variantId) return;

            const qtyInput = document.getElementById('purchaseQuantity');
            const qty = parseInt(qtyInput ? qtyInput.value : 1) || 1;

            isDetailsActionPending = true;
            if (btnElem) btnElem.disabled = true;

            addToCartAjax(variantId, qty, btnElem);

            setTimeout(() => {
                isDetailsActionPending = false;
                if (btnElem) btnElem.disabled = false;
            }, 1200);
        }

        function buyNowFromDetails(btnElem) {
            if (isDetailsActionPending || checkRageClickSpam()) return;

            const variantId = getValidVariantId();
            if (!variantId) return;

            const qtyInput = document.getElementById('purchaseQuantity');
            const qty = parseInt(qtyInput ? qtyInput.value : 1) || 1;

            isDetailsActionPending = true;
            if (btnElem) btnElem.disabled = true;

            const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': csrfToken
                },
                body: JSON.stringify({ variantId: variantId, quantity: qty })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    window.location.href = '/Order/Checkout';
                } else {
                    showToast(data.message, 'error');
                    isDetailsActionPending = false;
                    if (btnElem) btnElem.disabled = false;
                }
            })
            .catch(err => {
                console.error(err);
                isDetailsActionPending = false;
                if (btnElem) btnElem.disabled = false;
            });
        }
    </script>
}

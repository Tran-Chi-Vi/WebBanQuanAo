@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản";
}

<div class="container my-5">
    <div class="card p-4 p-md-5 border-0 shadow-lg rounded-4 bg-body max-w-550 mx-auto" style="max-width: 540px;">
        <div class="text-center mb-4">
            <i class="bi bi-person-plus-fill display-4 text-primary mb-2"></i>
            <h3 class="fw-bold font-heading m-0">TẠO TÀI KHOẢN MỚI</h3>
            <p class="text-muted small">Đăng ký để trải nghiệm dịch vụ mua sắm tuyệt vời</p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-bold small">Họ và tên</label>
                <input asp-for="FullName" class="form-control rounded-3" placeholder="Nguyễn Văn A" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label fw-bold small">Tên đăng nhập</label>
                    <input asp-for="Username" class="form-control rounded-3" placeholder="user123" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label fw-bold small">Số điện thoại</label>
                    <input asp-for="Phone" class="form-control rounded-3" placeholder="0901234567" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-bold small">Địa chỉ Email</label>
                <input asp-for="Email" class="form-control rounded-3" placeholder="email@example.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-bold small">Mật khẩu</label>
                    <div class="input-group">
                        <input asp-for="Password" id="registerPasswordInput" class="form-control rounded-start-3" placeholder="••••••••" />
                        <button class="btn btn-outline-secondary rounded-end-3 px-3" type="button" onclick="togglePasswordVisibility('registerPasswordInput', this)" title="Hiện/Ẩn mật khẩu" aria-label="Bấm để ẩn hoặc hiện mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-bold small">Xác nhận mật khẩu</label>
                    <div class="input-group">
                        <input asp-for="ConfirmPassword" id="registerConfirmPasswordInput" class="form-control rounded-start-3" placeholder="••••••••" />
                        <button class="btn btn-outline-secondary rounded-end-3 px-3" type="button" onclick="togglePasswordVisibility('registerConfirmPasswordInput', this)" title="Hiện/Ẩn mật khẩu" aria-label="Bấm để ẩn hoặc hiện mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary-gradient btn-lg w-100 py-3 font-heading fw-bold shadow-lg mb-3">
                ĐĂNG KÝ TÀI KHOẢN
            </button>
        </form>

        <div class="position-relative my-4">
            <hr class="text-muted opacity-25" />
            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">Hoặc đăng ký nhanh</span>
        </div>

        <!-- Google & Facebook Login Buttons -->
        <div class="d-flex gap-2 mb-4">
            <a asp-controller="Account" asp-action="GoogleLogin" class="btn btn-outline-danger w-50 py-2 rounded-3 font-heading fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm">
                <i class="bi bi-google"></i> Google
            </a>
            <a asp-controller="Account" asp-action="FacebookLogin" class="btn btn-outline-primary w-50 py-2 rounded-3 font-heading fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm">
                <i class="bi bi-facebook"></i> Facebook
            </a>
        </div>

        <div class="text-center small text-muted">
            Đã có tài khoản? <a asp-controller="Account" asp-action="Login" class="text-primary fw-bold text-decoration-none">Đăng nhập</a>
        </div>
    </div>
</div>
